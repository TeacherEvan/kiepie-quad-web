      "tool": {
        "driver": {
          "name": "surgical-audit-v3",
          "version": "3.0.0",
          "informationUri": "https://github.com/TeacherEvan/surgical-audit",
          "rules": [
            { "id": "KQ-P1-1", "name": "HornBeamBackwardsMesh", "shortDescription": { "text": "PlasmaBeam mesh spawns behind caster (-_direction)" }, "defaultConfiguration": { "level": "error" } },
            { "id": "KQ-P2-1", "name": "UnreachableLethalHitConfirmed", "shortDescription": { "text": "hit_any_enemy unreachable after fail-closed guard in apply_lethal_blast" }, "defaultConfiguration": { "level": "warning" } },
            { "id": "KQ-P2-2", "name": "DevilHandSetupLeakAndNaN", "shortDescription": { "text": "DevilHandStrike.setup leaks node on reject and omits p_target_pos is_finite check" }, "defaultConfiguration": { "level": "warning" } },
            { "id": "KQ-P2-3", "name": "StrikeSetupUnvalidatedParams", "shortDescription": { "text": "RocketProjectile and MeteorStrike setup omit is_finite and blast_radius clamp" }, "defaultConfiguration": { "level": "warning" } },
            { "id": "KQ-P2-4", "name": "SideCannonsPostAwaitRespawnRace", "shortDescription": { "text": "SideCannons.fire lacks generation guard across await Match.issue_shot()" }, "defaultConfiguration": { "level": "warning" } },
            { "id": "KQ-P2-5", "name": "WorkflowMissingPermissions", "shortDescription": { "text": "GitHub Actions workflow omits explicit permissions: contents: read" }, "defaultConfiguration": { "level": "warning" } },
            { "id": "KQ-P2-6", "name": "PckBudgetHeadroomExhausted", "shortDescription": { "text": "index.pck is 4.47 MiB with only 32.7 KB below 4.50 MiB abort cap" }, "defaultConfiguration": { "level": "warning" } },
            { "id": "KQ-P2-7", "name": "BlenderMissingSaveVersionZero", "shortDescription": { "text": "Older Blender builders omit save_version = 0 around save_as_mainfile" }, "defaultConfiguration": { "level": "warning" } },
            { "id": "SA-GOD-FILE", "name": "GodFileThresholdExceeded", "shortDescription": { "text": "Core runtime file exceeds 500 effective lines of code" }, "defaultConfiguration": { "level": "warning" } },
            { "id": "KQ-P3-LOW", "name": "LowSeverityAuditFinding", "shortDescription": { "text": "Low-severity maintainability, guard, or hygiene finding" }, "defaultConfiguration": { "level": "note" } }
          ]
        }
      },
