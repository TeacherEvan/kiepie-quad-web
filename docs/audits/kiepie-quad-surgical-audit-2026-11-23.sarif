{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "surgical-audit-preflight",
          "version": "3.0.0",
          "informationUri": "https://github.com/TeacherEvan/surgical-audit",
          "rules": [
            {
              "id": "SA-GOD-FILE",
              "name": "GodFileThresholdExceeded",
              "shortDescription": {
                "text": "File exceeds 400 effective lines of code"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "SA-HIGH-COMPLEXITY",
              "name": "HighComplexityHotspot",
              "shortDescription": {
                "text": "Function or file exceeds complexity (CC >= 10), nesting (> 5), or span LOC (>= 60)"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "SA-SILENT-CATCH",
              "name": "SilentExceptionHandler",
              "shortDescription": {
                "text": "Empty or pass-only exception catch handler swallows errors"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "SA-HOT-LOOP",
              "name": "HotLoopAllocationMarker",
              "shortDescription": {
                "text": "Per-frame or hot-loop allocation/callback marker detected"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "SA-PARSE-ERROR",
              "name": "SyntaxParseError",
              "shortDescription": {
                "text": "Syntax error prevented full AST inspection"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "SA-P1-1",
              "name": "SA-P1-1",
              "shortDescription": {
                "text": "Host-handoff _state_seq rollover drops all new-host state broadcasts on guests"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "SA-P1-2",
              "name": "SA-P1-2",
              "shortDescription": {
                "text": "LobbyService._enter_if_current() wipes newly entered active lobby on late cancel resolution"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "SA-P1-3",
              "name": "SA-P1-3",
              "shortDescription": {
                "text": "Unconditional R (reset_bike) instant spawn teleport exploit in live multiplayer"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "SA-P1-4",
              "name": "SA-P1-4",
              "shortDescription": {
                "text": "TouchControls._on_settings_changed() never updates _force (split-brain settings)"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "SA-P1-5",
              "name": "SA-P1-5",
              "shortDescription": {
                "text": "RaceTracker._on_roster_changed() defaults missing laps to completed_laps and disarms 3s recovery"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "SA-P2-1",
              "name": "SA-P2-1",
              "shortDescription": {
                "text": "Pooled Projectile/BananaProjectile slots freeze invisible after degenerate first call"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "SA-P2-2",
              "name": "SA-P2-2",
              "shortDescription": {
                "text": "VfxFactory.impact() holds WebGL2 OmniLight3D budget slot for 0.70s after 0.12s fade"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "SA-P2-3",
              "name": "SA-P2-3",
              "shortDescription": {
                "text": "MainMenu._ready() hides BtnRetry and sticks on Connecting after auth timeout"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "SA-P2-4",
              "name": "SA-P2-4",
              "shortDescription": {
                "text": "SettingsMenu quality preset drops pending debounced video/fov slider writes"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "SA-P2-5",
              "name": "SA-P2-5",
              "shortDescription": {
                "text": "VfxFactory.casing() ignores reduced_motion() and quality_multiplier() <= 0"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "SA-P2-6",
              "name": "SA-P2-6",
              "shortDescription": {
                "text": "Persistent architectural God files (17 tracked first-party files > 400 eff LOC)"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "SA-P2-7",
              "name": "SA-P2-7",
              "shortDescription": {
                "text": "TaloBackend.reconnect()/start() mints fresh anonymous alias instead of reusing current_alias"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "SA-P2-8",
              "name": "SA-P2-8",
              "shortDescription": {
                "text": "Web payload ceiling proximity: index.pck at 3.54 MiB (88.4% of 4 MiB deploy_web.sh cap)"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "SA-P3-1",
              "name": "SA-P3-1",
              "shortDescription": {
                "text": "MatchState._process() parses ISO-8601 started_at at 60-120 Hz on host"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "SA-P3-2",
              "name": "SA-P3-2",
              "shortDescription": {
                "text": "HUD/Touch toggle buttons missing ui_click SFX; unattenuated distant rocket/meteor shake"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "SA-P3-3",
              "name": "SA-P3-3",
              "shortDescription": {
                "text": "repair_and_verify.py shifts every MESH directly, skipping EMPTY anchors"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "SA-P3-4",
              "name": "SA-P3-4",
              "shortDescription": {
                "text": "MatchHud._fps_label hardcoded at (12, 272) overlaps AnalogSteer on 667x375 landscape"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "SA-P3-5",
              "name": "SA-P3-5",
              "shortDescription": {
                "text": "Minor durability/doc drift: patch_web_html.py fsync, AGENTS.md splash key/size, _base_power"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
