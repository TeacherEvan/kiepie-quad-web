{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "surgical-audit-v3-swarm",
          "version": "3.0.0",
          "informationUri": "https://github.com/TeacherEvan/surgical-audit",
          "rules": [
            {
              "id": "KQ-SW-P2-1",
              "name": "HostLossLatchNeverCleared",
              "shortDescription": {
                "text": "Host-loss latch cleared only on join/leave; reconnect path never clears it, causing permanent host-loss blindness"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "KQ-SW-P2-2",
              "name": "TriplicatedWinFSM",
              "shortDescription": {
                "text": "Win-transition FSM hand-copied across TaloBackend, MatchState and MockBackend"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "KQ-SW-P2-3",
              "name": "BoomerangFirstHitRaySweep",
              "shortDescription": {
                "text": "3-ray blade sweep breaks on first non-empty ray; far centre hit shadows near side rider"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "KQ-SW-P2-4",
              "name": "HazardTickOvershootDiscard",
              "shortDescription": {
                "text": "_tick_accum reset to 0.0 discards overshoot; cadence is frame-rate dependent"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "KQ-SW-P2-5",
              "name": "RaceFinishLatchUnboundedAwait",
              "shortDescription": {
                "text": "_finishing_lap latch held across two unbounded awaits with no timeout or generation guard"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "KQ-SW-P2-6",
              "name": "JoinCapacityTOCTOU",
              "shortDescription": {
                "text": "Cached member_count checked before awaited join with no post-join revalidation"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "KQ-SW-P2-7",
              "name": "ProtocolVersionOnlyAtJoin",
              "shortDescription": {
                "text": "PROTOCOL_VERSION stamped at join but never revalidated on reconnect; wire envelope has no version"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "KQ-SW-P3-1",
              "name": "WriteOnlyLobbyId",
              "shortDescription": {
                "text": "_lobby_id written twice and never read; fourth copy of lobby identity"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-2",
              "name": "DuplicatedMagicConstants",
              "shortDescription": {
                "text": "Literal 52.0 SHOT_SPEED and duplicated STALE_LOBBY_S/MIN_LAP_SECONDS across modules"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-3",
              "name": "60HzReticleRaycast",
              "shortDescription": {
                "text": "Meteor reticle aim recomputed every physics tick with group scan and raycast"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-4",
              "name": "KeysArrayPerFrame",
              "shortDescription": {
                "text": "Dictionary.keys() allocates a new Array every rendered frame"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-5",
              "name": "TouchInputPerFrameArrays",
              "shortDescription": {
                "text": "Per-frame Array allocation in analog input hot path"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-6",
              "name": "SplashMediaNotReleased",
              "shortDescription": {
                "text": "drop() never pauses or clears video src; detached media keeps decoding"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-7",
              "name": "StaleBundleSizeDocs",
              "shortDescription": {
                "text": "AGENTS.md still documents 4,279,216 B / 4.5 MiB abort vs actual 4,686,096 B / 5.0 MiB guard"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-8",
              "name": "EmptyVehiclePreference",
              "shortDescription": {
                "text": "sanitize_preference(\"\") returned as valid, overriding player choice via hash deal"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-9",
              "name": "FalseHitMarkerSoloBlast",
              "shortDescription": {
                "text": "Hazard ignition sets hit_any_enemy on owner id alone, emitting a false hit marker in solo play"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-10",
              "name": "NonAtomicExportVerifierWrites",
              "shortDescription": {
                "text": "Final blend/glb/stl written in place; crash leaves truncated shipped binary"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-11",
              "name": "BeaconAccumulatorDrift",
              "shortDescription": {
                "text": "Beacon tick accumulator zeroes instead of subtracting; cadence drifts at low fps"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-12",
              "name": "TimeUpGuardLeak",
              "shortDescription": {
                "text": "_time_up_called not cleared on lobby-id mismatch or set_lobby; reset_time_limit_guard has no callers"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-13",
              "name": "ParseEmptyVsMalformed",
              "shortDescription": {
                "text": "parse_dict returns {} for both empty and malformed JSON; unguarded Dictionary casts"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-14",
              "name": "UnvalidatedChannelBody",
              "shortDescription": {
                "text": "TaloChannel.new(body[channel]) has no is Dictionary guard despite HTTP 200"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-15",
              "name": "MockMirrorBackendGate",
              "shortDescription": {
                "text": "Mock backend forces null channel and never exercises real I/O rejection"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-16",
              "name": "ForgedFrameBypassesParser",
              "shortDescription": {
                "text": "Forged JSON fed directly to _on_socket_message, bypassing Talo typed parser"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-17",
              "name": "PresenceOnlyAssertions",
              "shortDescription": {
                "text": "Majority of test_kiepie_pad assertions are is_not_null presence checks"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-18",
              "name": "GlobalStateRestoreBypass",
              "shortDescription": {
                "text": "Global reduced_motion restore skipped on early quit(2) path"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-19",
              "name": "HappyPathCannonGate",
              "shortDescription": {
                "text": "Cannon gate has 8 assertions and zero negative/boundary signals"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-20",
              "name": "LiteralMarkerCoupling",
              "shortDescription": {
                "text": "SW patch test asserts literal marker substrings rather than behavior"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-21",
              "name": "SingleSampleTimeWindow",
              "shortDescription": {
                "text": "dust_ring sampled only at 0.35 s; slow-ramp peak invisible"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "KQ-SW-P3-22",
              "name": "ChargeSparksEmitBackward",
              "shortDescription": {
                "text": "Particle direction Vector3(0,0,1) in -Z-forward basis streams sparks out of the rear"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
