extends Node
## Tiny procedural sound-effect player for Kiepie Quad.
##
## Autoload name: Sfx (registered by the parent agent in project.godot).
## This script has NO autoload dependencies of its own, so it parses/loads on
## its own. The "SFX", "Engine" and "UI" buses are created at runtime by the
## Settings autoload, so every bus assignment is guarded and falls back to
## "Master" if a bus is not there yet (e.g. in a headless gate run).
##
## Samples live in res://assets/sfx/ and are generated by generate_sfx.py.
## They are loaded lazily in _ready() (never preload()) so this script still
## compiles before Godot has imported the WAV resources.

const SAMPLES := {
	"fire": "res://assets/sfx/cannon_fire.wav",
	"pop": "res://assets/sfx/pop.wav",
	"impact": "res://assets/sfx/impact.wav",
	"explosion": "res://assets/sfx/explosion.wav",
	"pickup": "res://assets/sfx/pickup.wav",
	"turbo": "res://assets/sfx/turbo.wav",
	"kill": "res://assets/sfx/kill.wav",
	"ui_click": "res://assets/sfx/ui_click.wav",
	"respawn": "res://assets/sfx/respawn.wav",
	"engine": "res://assets/sfx/engine_loop.wav",
}

const MAX_VOICES := 24
const PITCH_JITTER := 0.05  # +-5 % on repeated impact/fire sounds
const JITTERED := {"fire": true, "impact": true, "explosion": true, "pop": true}

var _streams: Dictionary = {}
var _voices: Array[AudioStreamPlayer] = []
var _voices3d: Array[AudioStreamPlayer3D] = []
var _engines: Dictionary = {}  # instance id -> engine player
var _rng := RandomNumberGenerator.new()


func _ready() -> void:
	_rng.randomize()
	for name in SAMPLES.keys():
		var res: Variant = load(SAMPLES[name])
		if res is AudioStream:
			_streams[name] = res
		else:
			push_warning("Sfx: sample missing or not imported: %s (%s)" % [name, SAMPLES[name]])


# ---------------------------------------------------------------------------
# public API
# ---------------------------------------------------------------------------
func play(name: String, volume_db: float = 0.0, pitch: float = 1.0) -> void:
	## Play a non-positional one-shot on the SFX bus.
	if not _has_voice_slot():
		return
	var stream := _streams.get(name) as AudioStream
	if stream == null:
		return
	var p := AudioStreamPlayer.new()
	p.stream = stream
	p.bus = _bus("SFX")
	p.volume_db = volume_db
	p.pitch_scale = _pitch(name, pitch)
	add_child(p)
	_voices.append(p)
	p.finished.connect(p.queue_free)
	p.play()


func play_3d(name: String, position: Vector3, volume_db: float = 0.0,
		pitch: float = 1.0) -> void:
	## Play a positional one-shot on the SFX bus (cannon hits, explosions...).
	if not _has_voice_slot():
		return
	var stream := _streams.get(name) as AudioStream
	if stream == null:
		return
	var p := AudioStreamPlayer3D.new()
	p.stream = stream
	p.bus = _bus("SFX")
	p.volume_db = volume_db
	p.pitch_scale = _pitch(name, pitch)
	add_child(p)
	p.global_position = position
	_voices3d.append(p)
	p.finished.connect(p.queue_free)
	p.play()


func play_ui(name: String) -> void:
	## Play a quiet one-shot on the UI bus (defaults to ui_click).
	if not _has_voice_slot():
		return
	var stream := _streams.get(name) as AudioStream
	if stream == null:
		return
	var p := AudioStreamPlayer.new()
	p.stream = stream
	p.bus = _bus("UI")
	p.volume_db = -3.0
	add_child(p)
	_voices.append(p)
	p.finished.connect(p.queue_free)
	p.play()


func start_engine(node: Node3D) -> AudioStreamPlayer3D:
	## Attach a looping engine player to node, start it and return it so the
	## caller can stop/remove it. Repeated calls for the same node reuse the
	## existing player. The stream is duplicated because changing loop_mode on
	## the shared imported resource would make every engine instance loop.
	if node == null:
		return null
	# prune engines whose host node was freed between arena loads
	for k in _engines.keys():
		if not is_instance_valid(_engines[k]) or instance_from_id(int(k)) == null:
			_engines.erase(k)
	var key := node.get_instance_id()
	if _engines.has(key):
		var existing: Variant = _engines[key]
		if is_instance_valid(existing):
			return existing as AudioStreamPlayer3D
		_engines.erase(key)

	if not _has_voice_slot():
		return null
	var base := _streams.get("engine") as AudioStreamWAV
	if base == null:
		push_warning("Sfx: engine sample missing or not imported")
		return null

	var stream := base.duplicate() as AudioStreamWAV
	# Godot 4.3 has no AudioStream.loop bool; loop_mode is the real API.
	stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
	stream.loop_begin = 0
	stream.loop_end = 0  # 0 == loop to the end of the 2 s seamless buffer

	var p := AudioStreamPlayer3D.new()
	p.stream = stream
	p.bus = _bus("Engine")
	p.volume_db = 0.0
	p.pitch_scale = 1.0
	node.add_child(p)
	_voices3d.append(p)
	_engines[key] = p
	p.play()
	return p


# ---------------------------------------------------------------------------
# internals
# ---------------------------------------------------------------------------
func _bus(preferred: String) -> String:
	if AudioServer.get_bus_index(preferred) >= 0:
		return preferred
	if AudioServer.get_bus_index("Master") >= 0:
		return "Master"
	return ""


func _pitch(name: String, pitch: float) -> float:
	if JITTERED.has(name):
		return maxf(0.05, pitch * _rng.randf_range(1.0 - PITCH_JITTER, 1.0 + PITCH_JITTER))
	return pitch


func _prune(arr: Array) -> void:
	var i := arr.size() - 1
	while i >= 0:
		if not is_instance_valid(arr[i]):
			arr.remove_at(i)
		i -= 1


func _has_voice_slot() -> bool:
	_prune(_voices)
	_prune(_voices3d)
	var count := _voices.size()
	for p in _voices:
		if not (p as AudioStreamPlayer).playing:
			count -= 1
	for p in _voices3d:
		if (p as AudioStreamPlayer3D).playing:
			count += 1
	return count < MAX_VOICES
