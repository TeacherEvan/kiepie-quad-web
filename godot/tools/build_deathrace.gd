extends SceneTree
# Builds res://scenes/DeathRace.tscn — the Grand-Prix Death Race circuit:
# closed oval/dogleg racetrack with 4 kerbed turns, inner/outer barriers,
# 2 full 360° stunt loops (TrackLoop0, TrackLoop1 with LoopZone centripetal adhesion),
# 3 molten hazard pits (HazardPit0..2), pit stop lane, 8 jump ramps, 10 pickups,
# 8 explosive fuel drums, 4 ordered checkpoint arches (Checkpoint0..3),
# checkered Start/Finish Line gantry (FinishLine), RaceTracker, local bike +
# CombatController, ArenaNet, MatchHud (with WeaponLabel + ReloadBar), and TouchHUD.
# Scenes are generated by builder scripts only — never hand-edited.

const OUT := "res://scenes/DeathRace.tscn"
const MATCH_HUD := "res://src/ui/MatchHud.gd"
const COMBAT := "res://src/game/CombatController.gd"
const FOLLOW_CAM := "res://src/FollowCam.gd"
const ARENA_NET := "res://src/game/ArenaNet.gd"
const RACE_TRACKER := "res://src/game/RaceTracker.gd"
const LOOP_ZONE := "res://src/game/LoopZone.gd"
const HAZARD_PIT := "res://src/game/HazardPit.gd"
const BUILDING := "res://src/DestructibleBuilding.gd"
const PICKUP := "res://src/game/Pickup.gd"
const FUEL_DRUM := "res://src/game/FuelDrum.gd"
const AMBIENT := "res://src/game/AmbientVfx.gd"
const DECOR := preload("res://src/game/BuildingDecor.gd")
const UI := preload("res://src/ui/UiTheme.gd")


func _chip(bg := Color(0.075, 0.085, 0.105, 0.80),
		border := Color(1.0, 1.0, 1.0, 0.08)) -> StyleBoxFlat:
	return UI.chip(bg, border, 12)


func _style_button(btn: Button, accent: Color) -> void:
	UI.style_button(btn, accent, 15, 44.0)


func _outlined(label: Label, color: Color, size: int, outline := 6) -> void:
	label.add_theme_font_size_override("font_size", size)
	label.add_theme_color_override("font_color", color)
	label.add_theme_constant_override("outline_size", outline)
	label.add_theme_color_override("font_outline_color", Color(0.0, 0.0, 0.0, 0.92))


func _initialize() -> void:
	var root := Node3D.new()
	root.name = "DeathRace"

	# ---------------- sunset race stadium environment
	var sky_mat := ProceduralSkyMaterial.new()
	sky_mat.sky_top_color = Color(0.08, 0.12, 0.28, 1)
	sky_mat.sky_horizon_color = Color(0.56, 0.38, 0.32, 1)
	sky_mat.ground_horizon_color = Color(0.32, 0.26, 0.24, 1)
	sky_mat.ground_bottom_color = Color(0.12, 0.11, 0.10, 1)
	sky_mat.sun_angle_max = 28.0
	sky_mat.sun_curve = 0.16
	var sky_res := Sky.new()
	sky_res.sky_material = sky_mat
	var env := Environment.new()
	env.background_mode = 2
	env.sky = sky_res
	env.ambient_light_source = 3
	env.ambient_light_sky_contribution = 0.62
	env.ambient_light_color = Color(0.84, 0.76, 0.72, 1)
	env.ambient_light_energy = 0.75
	env.fog_enabled = true
	env.fog_light_color = Color(0.36, 0.30, 0.34, 1)
	env.fog_density = 0.0016
	env.tonemap_mode = 3
	env.tonemap_exposure = 1.18
	var world_env := WorldEnvironment.new()
	world_env.environment = env
	root.add_child(world_env)

	# ---------------- sun
	var sun := DirectionalLight3D.new()
	sun.name = "Sun"
	sun.light_energy = 1.9
	sun.light_color = Color(1.0, 0.92, 0.80, 1)
	sun.shadow_enabled = true
	sun.directional_shadow_max_distance = 160.0
	sun.rotation_degrees = Vector3(-48.0, 35.0, 0.0)
	root.add_child(sun)

	# ---------------- stadium base floor (180 x 140 m)
	var ground := StaticBody3D.new()
	ground.name = "Ground"
	var ground_col := CollisionShape3D.new()
	var ground_shape := BoxShape3D.new()
	ground_shape.size = Vector3(180.0, 1.0, 140.0)
	ground_col.shape = ground_shape
	ground.add_child(ground_col)
	var ground_mesh := MeshInstance3D.new()
	var box := BoxMesh.new()
	box.size = Vector3(180.0, 1.0, 140.0)
	var asphalt := StandardMaterial3D.new()
	var asphalt_tex := load("res://assets/tex_asphalt.png") as Texture2D
	asphalt.albedo_texture = asphalt_tex
	asphalt.albedo_color = Color(0.55, 0.58, 0.64, 1)
	asphalt.roughness = 0.96
	asphalt.uv1_scale = Vector3(90.0, 70.0, 1.0)
	box.material = asphalt
	ground_mesh.mesh = box
	ground.add_child(ground_mesh)
	ground.position = Vector3(0.0, -0.5, 0.0)
	root.add_child(ground)

	# ---------------- circuit track surface ribbon, turns, barriers & pit stop lane
	_add_backdrop(root)
	_build_circuit(root)

	# ---------------- Start/Finish Line & 4 ordered Checkpoints
	# Track flows clockwise from North straight (z=-44, heading +X -> rot_y = 90 deg):
	#   Start/FinishLine at (0, 0, -44) facing +X (rot_y = 90°)
	#   Checkpoint0 at NE Turn 1 exit (58, 0, -16) facing +Z (rot_y = 0°)
	#   Checkpoint1 at SE Turn 2 exit (38, 0, 44) facing -X (rot_y = -90°)
	#   Checkpoint2 at SW Turn 3 exit (-58, 0, 16) facing -Z (rot_y = 180°)
	#   Checkpoint3 at NW Turn 4 exit (-38, 0, -44) facing +X (rot_y = 90°)
	_add_finish_line(root, Vector3(0.0, 0.0, -44.0), 90.0)
	_add_checkpoint(root, 0, Vector3(58.0, 0.0, -16.0), 0.0)
	_add_checkpoint(root, 1, Vector3(38.0, 0.0, 44.0), -90.0)
	_add_checkpoint(root, 2, Vector3(-58.0, 0.0, 16.0), 180.0)
	_add_checkpoint(root, 3, Vector3(-38.0, 0.0, -44.0), 90.0)

	# ---------------- 2 Full 360° Vertical Stunt Loops (with LoopZone centripetal normal)
	# TrackLoop0 on the North straight outer lane (east of FinishLine, heading +X)
	_add_stunt_loop(root, "TrackLoop0", Vector3(26.0, 0.0, -47.2), 90.0, 8.5)
	# TrackLoop1 on the South back-straight outer lane (heading -X)
	_add_stunt_loop(root, "TrackLoop1", Vector3(-14.0, 0.0, 47.2), -90.0, 8.5)

	# ---------------- 3 Molten Hazard Pits (with jump ramps over them)
	_add_hazard_pit(root, "HazardPit0", Vector3(58.0, 0.0, 10.0), Vector3(10.0, 1.4, 8.0))
	_add_hazard_pit(root, "HazardPit1", Vector3(14.0, 0.0, 44.0), Vector3(8.0, 1.4, 10.0))
	_add_hazard_pit(root, "HazardPit2", Vector3(-58.0, 0.0, -10.0), Vector3(10.0, 1.4, 8.0))

	# ---------------- 8 Ramps (pit jump kickers + loop/straight speed boosters)
	# East straight gap jump over HazardPit0 (heading +Z, rot_y = 180 launches +Z)
	_add_ramp(root, "Ramp0", Vector3(58.0, 0.0, 2.0), Vector3(15.0, 180.0, 0.0))
	_add_ramp(root, "Ramp1", Vector3(58.0, 0.0, 18.0), Vector3(10.0, 0.0, 0.0))
	# South back-straight gap jump over HazardPit1 (heading -X, rot_y = 90 launches -X)
	_add_ramp(root, "Ramp2", Vector3(22.0, 0.0, 44.0), Vector3(15.0, 90.0, 0.0))
	_add_ramp(root, "Ramp3", Vector3(6.0, 0.0, 44.0), Vector3(10.0, -90.0, 0.0))
	# West straight gap jump over HazardPit2 (heading -Z, rot_y = 0 launches -Z)
	_add_ramp(root, "Ramp4", Vector3(-58.0, 0.0, -2.0), Vector3(15.0, 0.0, 0.0))
	_add_ramp(root, "Ramp5", Vector3(-58.0, 0.0, -18.0), Vector3(10.0, 180.0, 0.0))
	# Turn exit kicker ramps
	_add_ramp(root, "Ramp6", Vector3(46.0, 0.0, -34.0), Vector3(12.0, 225.0, 0.0))
	_add_ramp(root, "Ramp7", Vector3(-46.0, 0.0, 34.0), Vector3(12.0, 45.0, 0.0))

	# ---------------- Pickups (10 total: along track apexes + Pit Stop Lane)
	_add_pickups(root)

	# ---------------- Fuel Drums (8 total: along chicane and pit walls)
	_add_fuel_drums(root)

	# ---------------- Infield destructible structures
	_add_building(root, "PitGarage", "Pit Garage",
			Vector3(0.0, 0.0, 18.0), Vector3(7.0, 3.6, 5.0), Color(0.45, 0.34, 0.28))
	_add_building(root, "RaceTower", "Race Control",
			Vector3(0.0, 0.0, -22.0), Vector3(5.2, 5.4, 4.6), Color(0.32, 0.40, 0.50))

	# ---------------- Ambient dust motes
	var ambient := Node3D.new()
	ambient.name = "AmbientVfx"
	ambient.set_script(load(AMBIENT))
	root.add_child(ambient)

	# ---------------- 8 Starting-Grid SpawnPoints behind FinishLine (facing +X, rot_y = 90 deg)
	for i in range(8):
		var row := int(i / 2)
		var col_side := -1.0 if (i % 2 == 0) else 1.0
		var sp := Node3D.new()
		sp.name = "SpawnPoint%d" % i
		sp.position = Vector3(-8.0 - float(row) * 4.5, 0.0, -44.0 + col_side * 3.2)
		sp.rotation_degrees = Vector3(0.0, 90.0, 0.0)  # local +Z points along +X toward FinishLine
		sp.add_to_group("spawn_point", true)
		root.add_child(sp)

	# ---------------- local bike + CombatController
	var bike_scene: PackedScene = load("res://scenes/KiepieBike.tscn")
	var bike := bike_scene.instantiate()
	bike.name = "KiepieBike"
	var sp0 := root.get_node("SpawnPoint0") as Node3D
	bike.position = sp0.position + Vector3(0.0, 0.6, 0.0)
	bike.rotation = sp0.rotation
	bike.add_to_group("bike", true)
	var combat := Node3D.new()
	combat.name = "CombatController"
	combat.set_script(load(COMBAT))
	bike.add_child(combat)
	root.add_child(bike)
	combat.owner = root

	# ---------------- camera rig + camera
	var rig := Node3D.new()
	rig.name = "CameraRig"
	rig.position = sp0.position + Vector3(-5.0, 2.2, 0.0)
	var cam := Camera3D.new()
	cam.name = "Camera3D"
	cam.current = true
	cam.fov = 62.0
	rig.add_child(cam)
	rig.set_script(load(FOLLOW_CAM))
	rig.set("target_path", NodePath("../KiepieBike"))
	root.add_child(rig)

	# ---------------- networking bridge
	var net := Node3D.new()
	net.name = "ArenaNet"
	net.set_script(load(ARENA_NET))
	net.set("local_bike_path", NodePath("../KiepieBike"))
	root.add_child(net)

	# ---------------- Death Race lap & checkpoint tracker
	var tracker := Node3D.new()
	tracker.name = "RaceTracker"
	tracker.set_script(load(RACE_TRACKER))
	tracker.set("local_bike_path", NodePath("../KiepieBike"))
	root.add_child(tracker)

	# ---------------- match HUD (shared MatchHud with WeaponLabel + ReloadBar)
	_add_match_hud(root)

	# ---------------- touch controls
	(load("res://tools/TouchOverlayKit.gd") as GDScript).build(root, "arena")

	# ---------------- save scene
	for child in root.get_children():
		child.owner = root
		if child.name != "KiepieBike":
			_set_owners(child, root)
	var scene := PackedScene.new()
	if scene.pack(root) != OK:
		printerr("pack failed: ", OUT)
		quit(1)
		return
	if ResourceSaver.save(scene, OUT) != OK:
		printerr("save failed: ", OUT)
		quit(1)
		return
	print("saved ", OUT)
	quit()


func _set_owners(node: Node, owner: Node) -> void:
	for child in node.get_children():
		child.owner = owner
		_set_owners(child, owner)


# --------------------------------------------------------------- circuit ---

static var _kerb_tex: ImageTexture = null
static var _check_tex: ImageTexture = null

func _kerb_stripe() -> ImageTexture:
	if _kerb_tex == null:
		var img := Image.create(2, 1, false, Image.FORMAT_RGB8)
		img.set_pixel(0, 0, Color(0.78, 0.14, 0.12, 1))
		img.set_pixel(1, 0, Color(0.90, 0.90, 0.88, 1))
		_kerb_tex = ImageTexture.create_from_image(img)
	return _kerb_tex


func _checkered_tex() -> ImageTexture:
	if _check_tex == null:
		var img := Image.create(16, 4, false, Image.FORMAT_RGB8)
		for y in range(4):
			for x in range(16):
				var is_white := ((x + y) % 2) == 0
				img.set_pixel(x, y, Color(0.96, 0.96, 0.98) if is_white else Color(0.08, 0.09, 0.12))
		_check_tex = ImageTexture.create_from_image(img)
	return _check_tex


func _glow_panel(color: Color, energy: float) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = color
	m.emission_enabled = true
	m.emission = color
	m.emission_energy_multiplier = energy
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	return m


func _add_backdrop(root: Node3D) -> void:
	var backdrop := Node3D.new()
	backdrop.name = "Backdrop"
	var lamp := _glow_panel(Color(1.0, 0.93, 0.72, 1), 3.0)
	var dark := StandardMaterial3D.new()
	dark.albedo_color = Color(0.11, 0.13, 0.16, 1)
	dark.roughness = 0.95
	var win := _glow_panel(Color(0.32, 0.56, 0.72, 1), 1.2)
	for sx in [-1.0, 1.0]:
		for sz in [-1.0, 1.0]:
			var tower := Node3D.new()
			tower.name = "Floodlight_%d_%d" % [int(sx), int(sz)]
			var mast := BoxMesh.new()
			mast.size = Vector3(0.65, 20.0, 0.65)
			mast.material = dark
			var mast_inst := MeshInstance3D.new()
			mast_inst.mesh = mast
			mast_inst.position = Vector3(0, 10.0, 0)
			tower.add_child(mast_inst)
			var bar := BoxMesh.new()
			bar.size = Vector3(5.0, 0.4, 0.65)
			bar.material = dark
			var bar_inst := MeshInstance3D.new()
			bar_inst.mesh = bar
			bar_inst.position = Vector3(0, 19.8, 0)
			tower.add_child(bar_inst)
			for i in range(4):
				var panel := BoxMesh.new()
				panel.size = Vector3(1.0, 0.55, 0.14)
				panel.material = lamp
				var p := MeshInstance3D.new()
				p.mesh = panel
				p.position = Vector3(-1.65 + float(i) * 1.1, 19.8, 0.36)
				tower.add_child(p)
			tower.position = Vector3(sx * 84.0, 0.0, sz * 66.0)
			backdrop.add_child(tower)
	var rng := RandomNumberGenerator.new()
	rng.seed = 77711
	for i in range(10):
		var a := TAU * float(i) / 10.0 + 0.15
		var r := rng.randf_range(98.0, 118.0)
		var h := rng.randf_range(6.0, 13.0)
		var w := rng.randf_range(12.0, 20.0)
		var hangar := Node3D.new()
		hangar.name = "Grandstand%d" % i
		var body := BoxMesh.new()
		body.size = Vector3(w, h, w * 0.65)
		body.material = dark
		var bi := MeshInstance3D.new()
		bi.mesh = body
		bi.position.y = h * 0.5
		hangar.add_child(bi)
		var strip := BoxMesh.new()
		strip.size = Vector3(w * 0.75, 0.28, 0.06)
		strip.material = win
		var si := MeshInstance3D.new()
		si.mesh = strip
		si.position = Vector3(0, h * 0.65, w * 0.33)
		hangar.add_child(si)
		hangar.position = Vector3(cos(a) * r, 0.0, sin(a) * r * 0.8)
		hangar.rotation.y = -a
		backdrop.add_child(hangar)
	root.add_child(backdrop)


func _build_circuit(root: Node) -> void:
	var track := Node3D.new()
	track.name = "CircuitTrack"
	root.add_child(track)

	var road_mat := StandardMaterial3D.new()
	var asphalt_tex := load("res://assets/tex_asphalt.png") as Texture2D
	road_mat.albedo_texture = asphalt_tex
	road_mat.albedo_color = Color(0.24, 0.26, 0.30, 1.0)
	road_mat.roughness = 0.88
	road_mat.uv1_scale = Vector3(24.0, 8.0, 1.0)

	# 4 straight ribbons + 4 corner turn pads + Pit Stop Lane
	var ribbons := [
		["NorthStraight", Vector3(0.0, 0.02, -44.0), Vector3(104.0, 0.05, 16.0), 0.0],
		["SouthStraight", Vector3(0.0, 0.02, 44.0), Vector3(104.0, 0.05, 16.0), 0.0],
		["EastStraight", Vector3(58.0, 0.02, 0.0), Vector3(16.0, 0.05, 76.0), 0.0],
		["WestStraight", Vector3(-58.0, 0.02, 0.0), Vector3(16.0, 0.05, 76.0), 0.0],
		["Turn1_NE", Vector3(52.0, 0.025, -38.0), Vector3(24.0, 0.05, 24.0), 45.0],
		["Turn2_SE", Vector3(52.0, 0.025, 38.0), Vector3(24.0, 0.05, 24.0), -45.0],
		["Turn3_SW", Vector3(-52.0, 0.025, 38.0), Vector3(24.0, 0.05, 24.0), 45.0],
		["Turn4_NW", Vector3(-52.0, 0.025, -38.0), Vector3(24.0, 0.05, 24.0), -45.0],
		["PitLane", Vector3(0.0, 0.025, 30.0), Vector3(44.0, 0.05, 8.0), 0.0],
	]
	for spec in ribbons:
		var mi := MeshInstance3D.new()
		mi.name = str(spec[0])
		var bm := BoxMesh.new()
		bm.size = spec[2]
		bm.material = road_mat
		mi.mesh = bm
		mi.position = spec[1]
		mi.rotation_degrees.y = float(spec[3])
		track.add_child(mi)

	# Glowing racing lane edge lines + corner directional chevron signs
	var line_mat := _glow_panel(Color(1.0, 0.76, 0.22, 1.0), 1.15)
	var edge_lines := [
		["EdgeLineN_In", Vector3(0.0, 0.052, -36.2), Vector3(96.0, 0.02, 0.28)],
		["EdgeLineN_Out", Vector3(0.0, 0.052, -51.8), Vector3(104.0, 0.02, 0.28)],
		["EdgeLineS_In", Vector3(0.0, 0.052, 36.2), Vector3(96.0, 0.02, 0.28)],
		["EdgeLineS_Out", Vector3(0.0, 0.052, 51.8), Vector3(104.0, 0.02, 0.28)],
		["EdgeLineE_In", Vector3(50.2, 0.052, 0.0), Vector3(0.28, 0.02, 68.0)],
		["EdgeLineE_Out", Vector3(65.8, 0.052, 0.0), Vector3(0.28, 0.02, 76.0)],
		["EdgeLineW_In", Vector3(-50.2, 0.052, 0.0), Vector3(0.28, 0.02, 68.0)],
		["EdgeLineW_Out", Vector3(-65.8, 0.052, 0.0), Vector3(0.28, 0.02, 76.0)],
	]
	for el in edge_lines:
		var lmi := MeshInstance3D.new()
		lmi.name = str(el[0])
		var lbm := BoxMesh.new()
		lbm.size = el[2]
		lbm.material = line_mat
		lmi.mesh = lbm
		lmi.position = el[1]
		track.add_child(lmi)

	# 4 Turn Apex Chevron Boards
	var chev_specs := [
		["ChevronTurn1", Vector3(66.0, 1.6, -46.0), -135.0, ">>> TURN 1 >>>"],
		["ChevronTurn2", Vector3(66.0, 1.6, 46.0), 135.0, ">>> TURN 2 >>>"],
		["ChevronTurn3", Vector3(-66.0, 1.6, 46.0), 45.0, ">>> TURN 3 >>>"],
		["ChevronTurn4", Vector3(-66.0, 1.6, -46.0), -45.0, ">>> TURN 4 >>>"],
	]
	for cs in chev_specs:
		var sign_lbl := Label3D.new()
		sign_lbl.name = str(cs[0])
		sign_lbl.text = str(cs[3])
		sign_lbl.font_size = 54
		sign_lbl.outline_size = 12
		sign_lbl.modulate = Color(1.0, 0.78, 0.20)
		sign_lbl.position = cs[1]
		sign_lbl.rotation_degrees.y = float(cs[2])
		track.add_child(sign_lbl)

	# Outer stadium boundary walls & inner infield barriers (keeps racers on the circuit)
	var walls := Node3D.new()
	walls.name = "Walls"
	root.add_child(walls)
	var barrier_mat := StandardMaterial3D.new()
	barrier_mat.albedo_texture = _kerb_stripe()
	barrier_mat.albedo_color = Color.WHITE
	barrier_mat.roughness = 0.72
	barrier_mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	barrier_mat.texture_repeat = true
	barrier_mat.uv1_scale = Vector3(18.0, 1.0, 1.0)

	var wall_specs := [
		["OuterWallN", Vector3(0.0, 0.9, -62.0), Vector3(156.0, 1.8, 1.2)],
		["OuterWallS", Vector3(0.0, 0.9, 62.0), Vector3(156.0, 1.8, 1.2)],
		["OuterWallE", Vector3(78.0, 0.9, 0.0), Vector3(1.2, 1.8, 125.0)],
		["OuterWallW", Vector3(-78.0, 0.9, 0.0), Vector3(1.2, 1.8, 125.0)],
		["InnerWallN", Vector3(0.0, 0.7, -33.0), Vector3(82.0, 1.4, 1.2)],
		["InnerWallS", Vector3(0.0, 0.7, 24.0), Vector3(62.0, 1.4, 1.2)],
		["InnerWallE", Vector3(45.0, 0.7, 0.0), Vector3(1.2, 1.4, 54.0)],
		["InnerWallW", Vector3(-45.0, 0.7, 0.0), Vector3(1.2, 1.4, 54.0)],
	]
	for ws in wall_specs:
		var sb := StaticBody3D.new()
		sb.name = str(ws[0])
		sb.position = ws[1]
		var col := CollisionShape3D.new()
		var sh := BoxShape3D.new()
		sh.size = ws[2]
		col.shape = sh
		sb.add_child(col)
		var mi := MeshInstance3D.new()
		var bm := BoxMesh.new()
		bm.size = ws[2]
		bm.material = barrier_mat
		mi.mesh = bm
		sb.add_child(mi)
		walls.add_child(sb)


# ---------------------------------------------- finish line & checkpoints ---

func _add_finish_line(root: Node, pos: Vector3, rot_y_deg: float) -> void:
	var finish := Area3D.new()
	finish.name = "FinishLine"
	finish.position = pos
	finish.rotation_degrees.y = rot_y_deg
	finish.collision_layer = 0
	finish.collision_mask = 1
	finish.monitoring = true
	finish.monitorable = false
	finish.add_to_group("finish_line", true)

	var col := CollisionShape3D.new()
