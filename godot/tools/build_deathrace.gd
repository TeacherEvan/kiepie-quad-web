	bm.material = check_mat
	banner.mesh = bm
	banner.position = Vector3(0.0, 6.0, 0.0)
	finish.add_child(banner)

	for trim_y: float in [5.40, 6.60]:
		var bar := MeshInstance3D.new()
		var tbm := BoxMesh.new()
		tbm.size = Vector3(17.4, 0.09, 0.52)
		tbm.material = trim_mat
		bar.mesh = tbm
		bar.position = Vector3(0.0, trim_y, 0.0)
		finish.add_child(bar)

	# 5 start-light pods suspended beneath the checkered gantry
	for li in range(5):
		var pod := MeshInstance3D.new()
		var sm := SphereMesh.new()
		sm.radius = 0.20
		sm.height = 0.40
		sm.material = light_pod_mat
		pod.mesh = sm
		pod.position = Vector3(-3.6 + float(li) * 1.8, 5.15, 0.0)
		finish.add_child(pod)

	# Dark matte header fascia box so front & back labels never Z-fight or bleed through
	var fascia := MeshInstance3D.new()
	fascia.name = "FinishFascia"
	var fbm := BoxMesh.new()
	fbm.size = Vector3(12.0, 1.10, 0.50)
	fbm.material = pillar_mat
	fascia.mesh = fbm
	fascia.position = Vector3(0.0, 7.15, 0.0)
	finish.add_child(fascia)

	for side_i in range(2):
		var lbl := Label3D.new()
		lbl.name = "FinishLabel" if side_i == 0 else "FinishLabelBack"
		lbl.text = "FINISH LINE"
		lbl.font_size = 56
		lbl.outline_size = 12
		lbl.double_sided = false
		lbl.modulate = Color(1.0, 0.88, 0.32)
		lbl.position = Vector3(0.0, 7.15, -0.28 if side_i == 0 else 0.28)
		if side_i == 0:
			lbl.rotation_degrees.y = 180.0
