# ------------------------------------------------------- 360° stunt loops ---

func _add_stunt_loop(root: Node, name: String, pos: Vector3, rot_y_deg: float, radius: float) -> void:
	var loop_root := Node3D.new()
	loop_root.name = name
	loop_root.position = pos
	loop_root.rotation_degrees.y = rot_y_deg

	# High-grip dark asphalt track deck with glowing neon-gold edge guide rails
	var deck_mat := StandardMaterial3D.new()
	var asphalt_tex := load("res://assets/tex_asphalt.png") as Texture2D
	deck_mat.albedo_texture = asphalt_tex
	deck_mat.albedo_color = Color(0.20, 0.22, 0.27, 1.0)
	deck_mat.roughness = 0.82
	deck_mat.uv1_scale = Vector3(2.0, 2.0, 1.0)

	var rail_mat := _glow_panel(Color(1.0, 0.56, 0.14), 1.45)
	var strut_mat := StandardMaterial3D.new()
	strut_mat.albedo_color = Color(0.14, 0.16, 0.20)
	strut_mat.metallic = 0.72
	strut_mat.roughness = 0.35

	var seg_count := 40
	var chord_len := 2.0 * radius * sin(PI / float(seg_count)) + 0.04
	var helical_pitch := 3.6  # lateral offset across 360° so exit clears entry cleanly
	var deck_w := 4.8
	var low_fric := PhysicsMaterial.new()
	low_fric.friction = 0.02
	low_fric.bounce = 0.0
	var shared_sh := BoxShape3D.new()
	shared_sh.size = Vector3(deck_w, 0.32, chord_len)
	var shared_bm := BoxMesh.new()
	shared_bm.size = Vector3(deck_w, 0.32, chord_len)
	shared_bm.material = deck_mat
	var shared_rbm := BoxMesh.new()
	shared_rbm.size = Vector3(0.18, 0.42, chord_len)
	shared_rbm.material = rail_mat

	for i in range(seg_count):
		var frac := (float(i) + 0.5) / float(seg_count)
		var theta := frac * TAU
		var x_off := (frac - 0.5) * helical_pitch
		var r_mid := radius + 0.16
		var y_pos := radius - r_mid * cos(theta)
		var z_pos := r_mid * sin(theta)

		var seg := StaticBody3D.new()
		seg.name = "LoopSeg%d" % i
		seg.physics_material_override = low_fric
		seg.position = Vector3(x_off, y_pos, z_pos)
		seg.rotation.x = -theta

		var col := CollisionShape3D.new()
		col.shape = shared_sh
		seg.add_child(col)

		var mi := MeshInstance3D.new()
		mi.mesh = shared_bm
		seg.add_child(mi)

		# Glowing edge guide rails along both sides of the loop deck
		for sgn: float in [-1.0, 1.0]:
			var rail := MeshInstance3D.new()
			rail.mesh = shared_rbm
			rail.position = Vector3(sgn * (deck_w * 0.5 - 0.05), 0.08, 0.0)
			seg.add_child(rail)

		loop_root.add_child(seg)

	# Structural steel A-frame support pillars anchoring the loop beside the deck
	for sgn: float in [-1.0, 1.0]:
		var strut := MeshInstance3D.new()
		strut.name = "SupportPylon_%s" % ("L" if sgn < 0.0 else "R")
		var cm := CylinderMesh.new()
		cm.top_radius = 0.25
		cm.bottom_radius = 0.38
		cm.height = radius * 2.05
		cm.material = strut_mat
		strut.mesh = cm
		strut.position = Vector3(sgn * 4.4, radius, 0.0)
		loop_root.add_child(strut)

	var top_beam := MeshInstance3D.new()
	var tbm := BoxMesh.new()
	tbm.size = Vector3(9.2, 0.45, 0.55)
	tbm.material = strut_mat
	top_beam.mesh = tbm
	top_beam.position = Vector3(0.0, radius * 2.05, 0.0)
	loop_root.add_child(top_beam)

	# LoopZone Area3D supplies centripetal normal adhesion strictly inside the loop footprint
	var zone := Area3D.new()
	zone.name = "LoopZone"
	zone.set_script(load(LOOP_ZONE))
	zone.set("loop_radius", radius)
	zone.set("helical_pitch", helical_pitch)
	var zcol := CollisionShape3D.new()
	zcol.name = "ZoneCollider"
	var zsh := BoxShape3D.new()
	zsh.size = Vector3(7.4, radius * 2.25, radius * 2.25)
	zcol.shape = zsh
	zcol.position = Vector3(0.0, radius, 0.0)
	zone.add_child(zcol)
	loop_root.add_child(zone)

	root.add_child(loop_root)


