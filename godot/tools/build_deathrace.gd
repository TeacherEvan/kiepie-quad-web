	mat.roughness = 0.85
	bm.material = mat
	mi.mesh = bm
	mi.position = Vector3(0.0, size.y * 0.5, 0.0)
	b.add_child(mi)

	var roof_mesh := BoxMesh.new()
	roof_mesh.size = Vector3(size.x + 0.5, 0.28, size.z + 0.5)
