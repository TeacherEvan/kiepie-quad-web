extends SceneTree
# Builds res://scenes/DeathRace.tscn — the Grand-Prix Death Race circuit:
# 550.6 m closed uniform cubic B-spline tarmac circuit (180 arc-length samples)
# with Serpent Esses, Furnace Bend, Canyon Switchback, and Victory Carousel,
# 3D beveled alternating FIA kerbs, continuous mitered concrete jersey barriers
# with impact attenuators, physical chevron turn boards, curved split pit lane
# with overhead gantry, 2 full 360° stunt loops (TrackLoop0/1 + LoopZone),
# 3 molten hazard pits (HazardPit0..2), 8 high-contrast jump ramps, 10 pickups,
# 8 spline-offset fuel drums, 4 ordered checkpoint arches (Checkpoint0..3),
# checkered Start/Finish Line gantry (FinishLine), RaceTracker, local bike +
# CombatController, ArenaNet, MatchHud (with WeaponLabel + ReloadBar), and TouchHUD.
# Scenes are generated by builder scripts only — never hand-edited.

const OUT := "res://scenes/DeathRace.tscn"
const MATCH_HUD := "res://src/ui/MatchHud.gd"
const COMBAT := "res://src/game/CombatController.gd"
const FOLLOW_CAM := "res://src/FollowCam.gd"
const ARENA_NET := "res://src/game/ArenaNet.gd"
const RACE_TRACKER := "res://src/game/RaceTracker.gd"
const LOOP_ZONE := "res://src/game/LoopZone.gd"
const HAZARD_PIT := "res://src/game/HazardPit.gd"
const BUILDING := "res://src/DestructibleBuilding.gd"
const PICKUP := "res://src/game/Pickup.gd"
const FUEL_DRUM := "res://src/game/FuelDrum.gd"
const AMBIENT := "res://src/game/AmbientVfx.gd"
const DECOR := preload("res://src/game/BuildingDecor.gd")
const UI := preload("res://src/ui/UiTheme.gd")


func _outlined(label: Label, color: Color, size: int, outline := 6) -> void:
	label.add_theme_font_size_override("font_size", size)
	label.add_theme_color_override("font_color", color)
	label.add_theme_constant_override("outline_size", outline)
	label.add_theme_color_override("font_outline_color", Color(0.0, 0.0, 0.0, 0.92))


func _initialize() -> void:
	var root := Node3D.new()
	root.name = "DeathRace"

	# ---------------- sunset race stadium environment
	var sky_mat := ProceduralSkyMaterial.new()
	sky_mat.sky_top_color = Color(0.08, 0.12, 0.28, 1)
	sky_mat.sky_horizon_color = Color(0.56, 0.38, 0.32, 1)
	sky_mat.ground_horizon_color = Color(0.32, 0.26, 0.24, 1)
	sky_mat.ground_bottom_color = Color(0.12, 0.11, 0.10, 1)
	sky_mat.sun_angle_max = 28.0
	sky_mat.sun_curve = 0.16
	var sky_res := Sky.new()
	sky_res.sky_material = sky_mat
	var env := Environment.new()
	env.background_mode = 2
	env.sky = sky_res
	env.ambient_light_source = 3
	env.ambient_light_sky_contribution = 0.62
	env.ambient_light_color = Color(0.84, 0.76, 0.72, 1)
	env.ambient_light_energy = 0.75
	env.fog_enabled = true
	env.fog_light_color = Color(0.36, 0.30, 0.34, 1)
	env.fog_density = 0.0014
	env.tonemap_mode = 3
	env.tonemap_exposure = 1.18
	var world_env := WorldEnvironment.new()
	world_env.environment = env
	root.add_child(world_env)

	# ---------------- sun
	var sun := DirectionalLight3D.new()
	sun.name = "Sun"
	sun.light_energy = 1.9
	sun.light_color = Color(1.0, 0.92, 0.80, 1)
	sun.shadow_enabled = true
	sun.directional_shadow_max_distance = 190.0
	sun.rotation_degrees = Vector3(-48.0, 35.0, 0.0)
	root.add_child(sun)

	# ---------------- stadium base floor (250 x 210 m) — warm desert-turf infield
	var ground := StaticBody3D.new()
	ground.name = "Ground"
	var ground_col := CollisionShape3D.new()
	var ground_shape := BoxShape3D.new()
	ground_shape.size = Vector3(250.0, 1.0, 210.0)
	ground_col.shape = ground_shape
	ground.add_child(ground_col)
	var ground_mesh := MeshInstance3D.new()
	var box := BoxMesh.new()
	box.size = Vector3(250.0, 1.0, 210.0)
	var infield_mat := StandardMaterial3D.new()
	infield_mat.albedo_texture = _infield_tex()
	infield_mat.albedo_color = Color.WHITE
	infield_mat.roughness = 0.96
	infield_mat.uv1_scale = Vector3(50.0, 42.0, 1.0)
	box.material = infield_mat
	ground_mesh.mesh = box
	ground.add_child(ground_mesh)
	ground.position = Vector3(0.0, -0.5, 0.0)
	root.add_child(ground)

	# Visual-only outer horizon skirt so the stadium blends into sunset fog with no slab edge
	var skirt := MeshInstance3D.new()
	skirt.name = "HorizonSkirt"
	var skirt_box := BoxMesh.new()
	skirt_box.size = Vector3(560.0, 0.2, 560.0)
	var skirt_mat := StandardMaterial3D.new()
	skirt_mat.albedo_color = Color(0.24, 0.21, 0.17, 1.0)
	skirt_mat.roughness = 0.98
	skirt_box.material = skirt_mat
	skirt.mesh = skirt_box
	skirt.position = Vector3(0.0, -0.10, 0.0)
	root.add_child(skirt)

	# ---------------- circuit track surface ribbon, turns, barriers & pit stop lane
	var pts := _sample_track_spline()
	_add_backdrop(root)
	_build_circuit(root, pts)

	# ---------------- Start/Finish Line & 4 ordered Checkpoints
	# Track flows clockwise from North straight (z=-62, heading +X -> rot_y = 90 deg):
	#   Start/FinishLine at (0, 0, -62) facing +X (rot_y = 90°)
	#   Checkpoint0 at East straight entry (88, 0, -22) facing +Z (rot_y = 0°)
	#   Checkpoint1 at South straight entry (14, 0, 62) facing -X (rot_y = -90°)
	#   Checkpoint2 at West straight entry (-88, 0, -8) facing -Z (rot_y = 180°)
	#   Checkpoint3 at North straight entry (-42, 0, -62) facing +X (rot_y = 90°)
	_add_finish_line(root, Vector3(0.0, 0.0, -62.0), 90.0)
	_add_checkpoint(root, 0, Vector3(88.0, 0.0, -22.0), 0.0)
	_add_checkpoint(root, 1, Vector3(14.0, 0.0, 62.0), -90.0)
	_add_checkpoint(root, 2, Vector3(-88.0, 0.0, -8.0), 180.0)
	_add_checkpoint(root, 3, Vector3(-42.0, 0.0, -62.0), 90.0)

	# ---------------- 2 Full 360° Vertical Stunt Loops (with LoopZone centripetal normal)
	# Positioned on dedicated outer stunt-loop aprons (z = ±78.0) so racers on the
	# flat straightaways (|z| <= 70.0) stay completely clear of LoopZone and pylons.
	_add_stunt_loop(root, "TrackLoop0", Vector3(22.0, 0.0, -78.0), 90.0, 9.5)
	_add_stunt_loop(root, "TrackLoop1", Vector3(-22.0, 0.0, 78.0), -90.0, 9.5)

	# ---------------- 3 Molten Hazard Pits (with jump ramps over them)
	_add_hazard_pit(root, "HazardPit0", Vector3(88.0, 0.0, -6.0), Vector3(10.0, 1.4, 8.0))
	_add_hazard_pit(root, "HazardPit1", Vector3(0.0, 0.0, 62.0), Vector3(8.0, 1.4, 10.0))
	_add_hazard_pit(root, "HazardPit2", Vector3(-88.0, 0.0, -22.0), Vector3(10.0, 1.4, 8.0))

	# ---------------- 8 Ramps (pit jump kickers + double-sided landing ramps + straight kickers)
	# _add_ramp() raises local +Z as the high launch lip (stand at +stand_z):
	#   rot_y = 0° launches +Z, rot_y = -90° launches -X, rot_y = 180° launches -Z, rot_y = 90° launches +X.
	# East straight gap jump over HazardPit0 (clockwise travel +Z)
	_add_ramp(root, "Ramp0", Vector3(88.0, 0.0, -14.0), Vector3(15.0, 0.0, 0.0), 4.6, false)
	_add_ramp(root, "Ramp1", Vector3(88.0, 0.0, 2.0), Vector3(10.0, 180.0, 0.0), 4.6, true)
	# South back-straight gap jump over HazardPit1 (clockwise travel -X)
	_add_ramp(root, "Ramp2", Vector3(8.0, 0.0, 62.0), Vector3(15.0, -90.0, 0.0), 4.6, false)
	_add_ramp(root, "Ramp3", Vector3(-8.0, 0.0, 62.0), Vector3(10.0, 90.0, 0.0), 4.6, true)
	# West straight gap jump over HazardPit2 (clockwise travel -Z)
	_add_ramp(root, "Ramp4", Vector3(-88.0, 0.0, -14.0), Vector3(15.0, 180.0, 0.0), 4.6, false)
	_add_ramp(root, "Ramp5", Vector3(-88.0, 0.0, -30.0), Vector3(10.0, 0.0, 0.0), 4.6, true)
	# Straightaway kicker ramps (clear of corner apexes)
	_add_ramp(root, "Ramp6", Vector3(24.0, 0.0, -62.0), Vector3(10.0, 90.0, 0.0), 3.6, false)
	_add_ramp(root, "Ramp7", Vector3(-28.0, 0.0, 62.0), Vector3(10.0, -90.0, 0.0), 3.6, false)

	# ---------------- Pickups (10 total: spline-anchored along track + Pit Stop Lane)
	_add_pickups(root, pts)

	# ---------------- Fuel Drums (8 total: spline-offset ±5.0 m from centerline, zero wall clipping)
	_add_fuel_drums(root, pts)

	# ---------------- Infield destructible structures (wide open center infield)
	_add_building(root, "PitGarage", "Pit Garage",
			Vector3(0.0, 0.0, 22.0), Vector3(7.0, 3.6, 5.0), Color(0.45, 0.34, 0.28))
	_add_building(root, "RaceTower", "Race Control",
			Vector3(0.0, 0.0, -28.0), Vector3(5.2, 5.4, 4.6), Color(0.32, 0.40, 0.50))

	# ---------------- Ambient dust motes
	var ambient := Node3D.new()
	ambient.name = "AmbientVfx"
	ambient.set_script(load(AMBIENT))
	root.add_child(ambient)

	# ---------------- 8 Starting-Grid SpawnPoints behind FinishLine (facing +X, rot_y = 90 deg)
	for i in range(8):
		var row := int(i / 2)
		var col_side := -1.0 if (i % 2 == 0) else 1.0
		var sp := Node3D.new()
		sp.name = "SpawnPoint%d" % i
		sp.position = Vector3(-8.0 - float(row) * 4.5, 0.0, -62.0 + col_side * 3.2)
		sp.rotation_degrees = Vector3(0.0, 90.0, 0.0)  # local +Z points along +X toward FinishLine
		sp.add_to_group("spawn_point", true)
		root.add_child(sp)

	# ---------------- local bike + CombatController
	var bike_scene: PackedScene = load("res://scenes/KiepieBike.tscn")
	var bike := bike_scene.instantiate()
	bike.name = "KiepieBike"
	var sp0 := root.get_node("SpawnPoint0") as Node3D
	bike.position = sp0.position + Vector3(0.0, 0.6, 0.0)
	bike.rotation = sp0.rotation
	bike.add_to_group("bike", true)
	var combat := Node3D.new()
	combat.name = "CombatController"
	combat.set_script(load(COMBAT))
	bike.add_child(combat)
	root.add_child(bike)
	combat.owner = root

	# ---------------- camera rig + camera
	var rig := Node3D.new()
	rig.name = "CameraRig"
	rig.position = sp0.position + Vector3(-5.0, 2.2, 0.0)
	var cam := Camera3D.new()
	cam.name = "Camera3D"
	cam.current = true
	cam.fov = 62.0
	rig.add_child(cam)
	rig.set_script(load(FOLLOW_CAM))
	rig.set("target_path", NodePath("../KiepieBike"))
	root.add_child(rig)

	# ---------------- networking bridge
	var net := Node3D.new()
	net.name = "ArenaNet"
	net.set_script(load(ARENA_NET))
	net.set("local_bike_path", NodePath("../KiepieBike"))
	root.add_child(net)

	# ---------------- Death Race lap & checkpoint tracker
	var tracker := Node3D.new()
	tracker.name = "RaceTracker"
	tracker.set_script(load(RACE_TRACKER))
	tracker.set("local_bike_path", NodePath("../KiepieBike"))
	root.add_child(tracker)

	# ---------------- match HUD (shared MatchHud with WeaponLabel + ReloadBar)
	_add_match_hud(root)

	# ---------------- touch controls
	(load("res://tools/TouchOverlayKit.gd") as GDScript).build(root, "arena")

	# ---------------- save scene
	for child in root.get_children():
		child.owner = root
		if child.name != "KiepieBike":
			_set_owners(child, root)
	var scene := PackedScene.new()
	if scene.pack(root) != OK:
		printerr("pack failed: ", OUT)
		quit(1)
		return
	if ResourceSaver.save(scene, OUT) != OK:
		printerr("save failed: ", OUT)
		quit(1)
		return
	print("saved ", OUT)
	quit()


func _set_owners(node: Node, owner: Node) -> void:
	for child in node.get_children():
		child.owner = owner
		_set_owners(child, owner)


# ------------------------------------------------------- textures & helpers ---

static var _kerb_tex_u: ImageTexture = null
static var _kerb_tex_v: ImageTexture = null
static var _check_tex: ImageTexture = null
static var _infield_img_tex: ImageTexture = null
static var _chevron_img_tex: ImageTexture = null


func _kerb_stripe() -> ImageTexture:
	if _kerb_tex_u == null:
		var img := Image.create(2, 1, false, Image.FORMAT_RGB8)
		img.set_pixel(0, 0, Color(0.84, 0.12, 0.10, 1))
		img.set_pixel(1, 0, Color(0.94, 0.94, 0.92, 1))
		_kerb_tex_u = ImageTexture.create_from_image(img)
	return _kerb_tex_u


func _kerb_stripe_v() -> ImageTexture:
	# 1x2 vertical red/white block texture so UV.y = arc_len alternates crisply along curves
	if _kerb_tex_v == null:
		var img := Image.create(1, 2, false, Image.FORMAT_RGB8)
		img.set_pixel(0, 0, Color(0.84, 0.12, 0.10, 1))
		img.set_pixel(0, 1, Color(0.94, 0.94, 0.92, 1))
		_kerb_tex_v = ImageTexture.create_from_image(img)
	return _kerb_tex_v


func _checkered_tex() -> ImageTexture:
	if _check_tex == null:
		var img := Image.create(16, 4, false, Image.FORMAT_RGB8)
		for y in range(4):
			for x in range(16):
				var is_white := ((x + y) % 2) == 0
				img.set_pixel(x, y, Color(0.96, 0.96, 0.98) if is_white else Color(0.08, 0.09, 0.12))
		_check_tex = ImageTexture.create_from_image(img)
	return _check_tex


func _infield_tex() -> ImageTexture:
	if _infield_img_tex == null:
		var noise := FastNoiseLite.new()
		noise.seed = 9041
		noise.frequency = 0.08
		noise.fractal_octaves = 3
		var img := Image.create(64, 64, false, Image.FORMAT_RGB8)
		for y in range(64):
			for x in range(64):
				var n := noise.get_noise_2d(float(x), float(y)) * 0.5 + 0.5
				var col := Color(0.36, 0.30, 0.22).lerp(Color(0.46, 0.39, 0.28), n)
				img.set_pixel(x, y, col)
		_infield_img_tex = ImageTexture.create_from_image(img)
	return _infield_img_tex


func _chevron_tex() -> ImageTexture:
	if _chevron_img_tex == null:
		var w := 64
		var h := 32
		var img := Image.create(w, h, false, Image.FORMAT_RGB8)
		var bg := Color(0.06, 0.07, 0.09, 1.0)
		var fg := Color(1.0, 0.80, 0.10, 1.0)
		for y in range(h):
			for x in range(w):
				var hit := false
				for cx in [12, 30, 48]:
					var dy := absf(float(y) - 15.5)
					var dx := float(x) - (float(cx) - dy * 0.65)
					if dx >= 0.0 and dx <= 6.5 and dy <= 12.0:
						hit = true
						break
				img.set_pixel(x, y, fg if hit else bg)
		_chevron_img_tex = ImageTexture.create_from_image(img)
	return _chevron_img_tex


func _glow_panel(color: Color, energy: float) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = color
	m.emission_enabled = true
	m.emission = color
	m.emission_energy_multiplier = energy
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	return m


func _add_backdrop(root: Node3D) -> void:
	var backdrop := Node3D.new()
	backdrop.name = "Backdrop"
	var lamp := _glow_panel(Color(1.0, 0.93, 0.72, 1), 3.0)
	var dark := StandardMaterial3D.new()
	dark.albedo_color = Color(0.14, 0.16, 0.20, 1)
	dark.roughness = 0.92
	var seat_mat := StandardMaterial3D.new()
	seat_mat.albedo_color = Color(0.26, 0.28, 0.34, 1)
	seat_mat.roughness = 0.85
	var canopy_mat := StandardMaterial3D.new()
	canopy_mat.albedo_color = Color(0.18, 0.20, 0.25, 1)
	canopy_mat.metallic = 0.45
	canopy_mat.roughness = 0.45
	var win := _glow_panel(Color(0.32, 0.72, 0.96, 1), 1.35)

	for sx: float in [-1.0, 1.0]:
		for sz: float in [-1.0, 1.0]:
			var tower := Node3D.new()
			tower.name = "Floodlight_%d_%d" % [int(sx), int(sz)]
			var mast := BoxMesh.new()
			mast.size = Vector3(0.70, 22.0, 0.70)
			mast.material = dark
			var mast_inst := MeshInstance3D.new()
			mast_inst.mesh = mast
			mast_inst.position = Vector3(0, 11.0, 0)
			tower.add_child(mast_inst)
			var bar := BoxMesh.new()
			bar.size = Vector3(5.6, 0.45, 0.70)
			bar.material = dark
			var bar_inst := MeshInstance3D.new()
			bar_inst.mesh = bar
			bar_inst.position = Vector3(0, 21.8, 0)
			tower.add_child(bar_inst)
			for i in range(4):
				var panel := BoxMesh.new()
				panel.size = Vector3(1.1, 0.60, 0.16)
				panel.material = lamp
				var p := MeshInstance3D.new()
				p.mesh = panel
				p.position = Vector3(-1.8 + float(i) * 1.2, 21.8, 0.38)
				tower.add_child(p)
			tower.position = Vector3(sx * 112.0, 0.0, sz * 88.0)
			tower.rotation.y = atan2(-tower.position.x, -tower.position.z)
			backdrop.add_child(tower)

	# Tiered stadium grandstands firmly seated inside the 250x210 stadium perimeter
	var rng := RandomNumberGenerator.new()
	rng.seed = 77711
	for i in range(10):
		var a := TAU * float(i) / 10.0 + 0.15
		var r := rng.randf_range(114.0, 122.0)
		var h := rng.randf_range(7.0, 10.5)
		var w := rng.randf_range(16.0, 24.0)
		var gx := cos(a) * r
		var gz := sin(a) * r * 0.78
		var stand := Node3D.new()
		stand.name = "Grandstand%d" % i

		# Concrete base deck
		var base_m := BoxMesh.new()
		base_m.size = Vector3(w, h * 0.42, 9.0)
		base_m.material = dark
		var base_i := MeshInstance3D.new()
		base_i.mesh = base_m
		base_i.position = Vector3(0.0, h * 0.21, 0.0)
		stand.add_child(base_i)

		# Two stepped seating tiers facing the track (+Z local)
		for tier in range(2):
			var tm := BoxMesh.new()
			tm.size = Vector3(w * 0.94, h * 0.26, 3.8 - float(tier) * 1.1)
			tm.material = seat_mat
			var ti := MeshInstance3D.new()
			ti.mesh = tm
			ti.position = Vector3(0.0, h * (0.48 + float(tier) * 0.22), -1.0 - float(tier) * 1.5)
			stand.add_child(ti)

		# Cantilevered stadium roof canopy + glowing fascia strip
		var roof_m := BoxMesh.new()
		roof_m.size = Vector3(w + 1.4, 0.55, 8.2)
		roof_m.material = canopy_mat
		var roof_i := MeshInstance3D.new()
		roof_i.mesh = roof_m
		roof_i.position = Vector3(0.0, h + 0.8, -0.4)
		roof_i.rotation_degrees.x = 8.0
		stand.add_child(roof_i)

		var strip := BoxMesh.new()
		strip.size = Vector3(w * 0.88, 0.30, 0.12)
		strip.material = win
		var si := MeshInstance3D.new()
		si.mesh = strip
		si.position = Vector3(0.0, h + 0.3, 3.7)
		stand.add_child(si)

		stand.position = Vector3(gx, 0.0, gz)
		stand.rotation.y = atan2(-gx, -gz)
		backdrop.add_child(stand)
	root.add_child(backdrop)


# --------------------------------------------------------------- circuit ---

func _bspline_eval(p0: Vector2, p1: Vector2, p2: Vector2, p3: Vector2, t: float) -> Vector2:
	var t2 := t * t
	var t3 := t2 * t
	var omt := 1.0 - t
	var b0 := (omt * omt * omt) / 6.0
	var b1 := (3.0 * t3 - 6.0 * t2 + 4.0) / 6.0
	var b2 := (-3.0 * t3 + 3.0 * t2 + 3.0 * t + 1.0) / 6.0
	var b3 := t3 / 6.0
	return p0 * b0 + p1 * b1 + p2 * b2 + p3 * b3


func _sample_track_spline() -> Array[Vector2]:
	var ctrl: Array[Vector2] = [
		# North Start/Finish Straight (z = -62, heading +X)
		Vector2(-40.0, -62.0), Vector2(-14.0, -62.0), Vector2(14.0, -62.0), Vector2(42.0, -62.0),
		# Turn 1: NE Blaster Sweeper
		Vector2(68.0, -60.0), Vector2(86.0, -44.0),
		# East Jump Straight (x = +88, heading +Z)
		Vector2(88.0, -24.0), Vector2(88.0, -8.0), Vector2(88.0, 8.0),
		# Sector 2: East Serpent Esses + SE Furnace Bend
		Vector2(86.0, 24.0), Vector2(70.0, 32.0), Vector2(56.0, 42.0), Vector2(58.0, 56.0), Vector2(50.0, 70.0), Vector2(32.0, 68.0),
		# South Power Straight (z = +62, heading -X)
		Vector2(16.0, 62.0), Vector2(-14.0, 62.0), Vector2(-42.0, 62.0),
		# Sector 3: Turn 3 SW Sweeper + West Canyon Switchback
		Vector2(-68.0, 62.0), Vector2(-86.0, 50.0), Vector2(-84.0, 34.0), Vector2(-68.0, 24.0), Vector2(-66.0, 8.0), Vector2(-82.0, -2.0),
		# West Jump Straight (x = -88, heading -Z)
		Vector2(-88.0, -14.0), Vector2(-88.0, -26.0), Vector2(-88.0, -38.0),
		# Sector 4: NW Victory Carousel
		Vector2(-78.0, -56.0), Vector2(-58.0, -62.0),
	]
	var dense: Array[Vector2] = []
	var n := ctrl.size()
	for i in range(n):
		var p0 := ctrl[(i - 1 + n) % n]
		var p1 := ctrl[i]
		var p2 := ctrl[(i + 1) % n]
		var p3 := ctrl[(i + 2) % n]
		for s in range(16):
			dense.append(_bspline_eval(p0, p1, p2, p3, float(s) / 16.0))
	var cum: Array[float] = [0.0]
	var dn := dense.size()
	for i in range(1, dn + 1):
		var a := dense[i - 1]
		var b := dense[i % dn]
		cum.append(cum[-1] + a.distance_to(b))
	var total := cum[-1]
	var M := 180
	var pts: Array[Vector2] = []
	var j := 0
	for k in range(M):
		var target := (float(k) / float(M)) * total
		while j + 1 < cum.size() and cum[j + 1] < target:
			j += 1
		var seg_len := maxf(1e-6, cum[j + 1] - cum[j])
		var u := (target - cum[j]) / seg_len
		pts.append(dense[j % dn].lerp(dense[(j + 1) % dn], u))
	return pts


func _add_quad_to_st(st: SurfaceTool, p00: Vector3, p10: Vector3, p01: Vector3, p11: Vector3,
		u0: float, u1: float, v0: float, v1: float, nrm: Vector3 = Vector3.UP) -> void:
	st.set_normal(nrm)
	st.set_uv(Vector2(u0, v0))
	st.add_vertex(p00)
	st.set_normal(nrm)
	st.set_uv(Vector2(u1, v0))
	st.add_vertex(p10)
	st.set_normal(nrm)
	st.set_uv(Vector2(u1, v1))
	st.add_vertex(p11)

	st.set_normal(nrm)
	st.set_uv(Vector2(u0, v0))
	st.add_vertex(p00)
	st.set_normal(nrm)
	st.set_uv(Vector2(u1, v1))
	st.add_vertex(p11)
	st.set_normal(nrm)
	st.set_uv(Vector2(u0, v1))
	st.add_vertex(p01)


func _is_wall_gap(side: float, mid: Vector2) -> bool:
	# Wide, clean openings for TrackLoop0 (N), TrackLoop1 (S), and curved PitLane (S inner)
	if side < 0.0 and mid.y < -54.0 and mid.x > 0.0 and mid.x < 44.0:
		return true
	if side < 0.0 and mid.y > 54.0 and mid.x > -44.0 and mid.x < 0.0:
		return true
	if side > 0.0 and mid.y > 46.0 and mid.x > -36.0 and mid.x < 36.0:
		return true
	return false


static var _atten_cm: CylinderMesh = null


func _add_attenuator(parent: Node, pos: Vector3, mat: Material) -> void:
	if _atten_cm == null:
		_atten_cm = CylinderMesh.new()
		_atten_cm.top_radius = 0.44
		_atten_cm.bottom_radius = 0.50
		_atten_cm.height = 1.52
		_atten_cm.radial_segments = 12
		_atten_cm.material = mat
	var mi := MeshInstance3D.new()
	mi.mesh = _atten_cm
	mi.position = Vector3(pos.x, 0.76, pos.z)
	parent.add_child(mi)


func _add_chevron_arc(parent: Node, group_name: String, pts: Array[Vector2],
		tangents: Array[Vector2], normals: Array[Vector2],
		start_idx: int, end_idx: int, count: int, side: float,
		board_mat: Material, post_mat: Material) -> void:
	var grp := Node3D.new()
	grp.name = group_name
	var M := pts.size()
	var span := (end_idx - start_idx + M) % M
	if span <= 0:
		span = M
	var bm := BoxMesh.new()
	bm.size = Vector3(3.4, 1.35, 0.16)
	bm.material = board_mat
	var pm := BoxMesh.new()
	pm.size = Vector3(0.18, 2.0, 0.18)
	pm.material = post_mat

	for k in range(count):
		var frac := (float(k) + 0.5) / float(count)
		var idx := (start_idx + int(roundf(frac * float(span)))) % M
		var p := pts[idx] + normals[idx] * (10.8 * side)
		var t := tangents[idx]
		var holder := Node3D.new()
		holder.name = "%s_%d" % [group_name, k]
		holder.position = Vector3(p.x, 0.0, p.y)
		# Local +Z faces oncoming traffic (-tangent)
		holder.rotation.y = atan2(-t.x, -t.y)

		var board := MeshInstance3D.new()
		board.mesh = bm
		board.position = Vector3(0.0, 2.0, 0.0)
		holder.add_child(board)

		for px: float in [-1.1, 1.1]:
			var post := MeshInstance3D.new()
			post.mesh = pm
			post.position = Vector3(px, 1.0, -0.06)
			holder.add_child(post)

		grp.add_child(holder)
	parent.add_child(grp)


func _build_circuit(root: Node, pts: Array[Vector2]) -> void:
	var track := Node3D.new()
	track.name = "CircuitTrack"
	root.add_child(track)

	var M := pts.size()
	var normals: Array[Vector2] = []
	var tangents: Array[Vector2] = []
	for i in range(M):
		var a := pts[(i - 1 + M) % M]
		var c := pts[(i + 1) % M]
		var t := (c - a).normalized()
		tangents.append(t)
		normals.append(Vector2(-t.y, t.x))

	var road_mat := StandardMaterial3D.new()
	var asphalt_tex := load("res://assets/tex_asphalt.png") as Texture2D
	road_mat.albedo_texture = asphalt_tex
	road_mat.albedo_color = Color(0.16, 0.18, 0.22, 1.0)
	road_mat.roughness = 0.90

	var center_mat := StandardMaterial3D.new()
	center_mat.albedo_color = Color(0.86, 0.88, 0.90, 1.0)
	center_mat.roughness = 0.78

	var line_mat := _glow_panel(Color(1.0, 0.76, 0.22, 1.0), 1.15)
	var kerb_mat := StandardMaterial3D.new()
	kerb_mat.albedo_texture = _kerb_stripe_v()
	kerb_mat.albedo_color = Color.WHITE
	kerb_mat.roughness = 0.70
	kerb_mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	kerb_mat.texture_repeat = true

	var st_road := SurfaceTool.new()
	st_road.begin(Mesh.PRIMITIVE_TRIANGLES)
	var st_center := SurfaceTool.new()
	st_center.begin(Mesh.PRIMITIVE_TRIANGLES)
	var st_lines := SurfaceTool.new()
	st_lines.begin(Mesh.PRIMITIVE_TRIANGLES)
	var st_kerbs := SurfaceTool.new()
	st_kerbs.begin(Mesh.PRIMITIVE_TRIANGLES)

	var arc := 0.0
	var half_w := 8.0
	var kerb_count := 0
	for i in range(M):
		var ni := (i + 1) % M
		var p0 := pts[i]
		var p1 := pts[ni]
		var n0 := normals[i]
		var n1 := normals[ni]
		var seg_len := p0.distance_to(p1)
		var v0 := arc / 8.0
		var v1 := (arc + seg_len) / 8.0
		var kv0 := arc / 2.2
		var kv1 := (arc + seg_len) / 2.2
		arc += seg_len

		# Main dark-charcoal asphalt ribbon (CW winding from +Y)
		var r0_l := Vector3(p0.x - n0.x * half_w, 0.025, p0.y - n0.y * half_w)
		var r0_r := Vector3(p0.x + n0.x * half_w, 0.025, p0.y + n0.y * half_w)
		var r1_l := Vector3(p1.x - n1.x * half_w, 0.025, p1.y - n1.y * half_w)
		var r1_r := Vector3(p1.x + n1.x * half_w, 0.025, p1.y + n1.y * half_w)
		_add_quad_to_st(st_road, r0_r, r0_l, r1_r, r1_l, 0.0, 2.0, v0, v1)

		# Crisp dashed center racing stripe
		if i % 2 == 0:
			var c0_l := Vector3(p0.x - n0.x * 0.16, 0.036, p0.y - n0.y * 0.16)
			var c0_r := Vector3(p0.x + n0.x * 0.16, 0.036, p0.y + n0.y * 0.16)
			var c1_l := Vector3(p1.x - n1.x * 0.16, 0.036, p1.y - n1.y * 0.16)
			var c1_r := Vector3(p1.x + n1.x * 0.16, 0.036, p1.y + n1.y * 0.16)
			_add_quad_to_st(st_center, c0_r, c0_l, c1_r, c1_l, 0.0, 1.0, 0.0, 1.0)

		# Glowing amber-gold boundary edge lines on both sides
		for sgn: float in [-1.0, 1.0]:
			var lo := 7.45 * sgn
			var hi := 7.80 * sgn
			var e0_a := Vector3(p0.x + n0.x * lo, 0.042, p0.y + n0.y * lo)
			var e0_b := Vector3(p0.x + n0.x * hi, 0.042, p0.y + n0.y * hi)
			var e1_a := Vector3(p1.x + n1.x * lo, 0.042, p1.y + n1.y * lo)
			var e1_b := Vector3(p1.x + n1.x * hi, 0.042, p1.y + n1.y * hi)
			if sgn < 0.0:
				_add_quad_to_st(st_lines, e0_a, e0_b, e1_a, e1_b, 0.0, 1.0, v0, v1)
			else:
				_add_quad_to_st(st_lines, e0_b, e0_a, e1_b, e1_a, 0.0, 1.0, v0, v1)

		# 3D beveled FIA alternating red/white kerbs along turns & chicanes
		var ang := absf(tangents[i].angle_to(tangents[ni]))
		if ang / maxf(seg_len, 0.1) > 0.012:
			kerb_count += 1
			for sgn: float in [-1.0, 1.0]:
				var ka := 8.05 * sgn
				var kb := 9.30 * sgn
				var k0_a := Vector3(p0.x + n0.x * ka, 0.044, p0.y + n0.y * ka)
				var k0_b := Vector3(p0.x + n0.x * kb, 0.120, p0.y + n0.y * kb)
				var k1_a := Vector3(p1.x + n1.x * ka, 0.044, p1.y + n1.y * ka)
				var k1_b := Vector3(p1.x + n1.x * kb, 0.120, p1.y + n1.y * kb)
				if sgn < 0.0:
					_add_quad_to_st(st_kerbs, k0_a, k0_b, k1_a, k1_b, 0.0, 1.0, kv0, kv1)
				else:
					_add_quad_to_st(st_kerbs, k0_b, k0_a, k1_b, k1_a, 0.0, 1.0, kv0, kv1)

	st_road.index()
	var road_mi := MeshInstance3D.new()
	road_mi.name = "TrackRibbon"
	road_mi.mesh = st_road.commit()
	road_mi.material_override = road_mat
	track.add_child(road_mi)

	st_center.index()
	var center_mi := MeshInstance3D.new()
	center_mi.name = "TrackCenterLine"
	center_mi.mesh = st_center.commit()
	center_mi.material_override = center_mat
	track.add_child(center_mi)

	st_lines.index()
	var lines_mi := MeshInstance3D.new()
	lines_mi.name = "TrackEdgeLines"
	lines_mi.mesh = st_lines.commit()
	lines_mi.material_override = line_mat
	track.add_child(lines_mi)

	if kerb_count > 0:
		st_kerbs.index()
		var kerbs_mi := MeshInstance3D.new()
		kerbs_mi.name = "TrackKerbs"
		kerbs_mi.mesh = st_kerbs.commit()
		kerbs_mi.material_override = kerb_mat
		track.add_child(kerbs_mi)

	# Starting Grid Brackets at SpawnPoint0..7
	var fbm := BoxMesh.new()
	fbm.size = Vector3(0.18, 0.012, 2.2)
	fbm.material = center_mat
	var sbm := BoxMesh.new()
	sbm.size = Vector3(1.1, 0.012, 0.16)
	sbm.material = center_mat
	for gi in range(8):
		var grow := int(gi / 2)
		var gside := -1.0 if (gi % 2 == 0) else 1.0
		var gx := -8.0 - float(grow) * 4.5
		var gz := -62.0 + gside * 3.2
		var gnode := Node3D.new()
		gnode.name = "GridBox%d" % gi
		gnode.position = Vector3(gx, 0.038, gz)
		var front_bar := MeshInstance3D.new()
		front_bar.mesh = fbm
		front_bar.position = Vector3(1.2, 0.0, 0.0)
		gnode.add_child(front_bar)
		for sz_s: float in [-1.0, 1.0]:
			var side_bar := MeshInstance3D.new()
			side_bar.mesh = sbm
			side_bar.position = Vector3(0.65, 0.0, sz_s * 1.02)
			gnode.add_child(side_bar)
		track.add_child(gnode)

	# Curved Split Pit Stop Lane (bypasses HazardPit1) + Stunt Loop Aprons
	var pit_mat := road_mat.duplicate() as StandardMaterial3D
	pit_mat.albedo_color = Color(0.14, 0.19, 0.26, 1.0)
	var pit_line := _glow_panel(Color(0.22, 0.88, 1.0, 1.0), 1.35)
	var pit_pts: Array[Vector2] = []
	var pit_ctrl: Array[Vector2] = [
		Vector2(34.0, 62.0), Vector2(26.0, 52.0), Vector2(18.0, 44.0),
		Vector2(0.0, 44.0), Vector2(-18.0, 44.0), Vector2(-26.0, 52.0), Vector2(-34.0, 62.0),
	]
	for pi in range(pit_ctrl.size() - 1):
		var a := pit_ctrl[pi]
		var b := pit_ctrl[pi + 1]
		for sub in range(4):
			pit_pts.append(a.lerp(b, float(sub) / 4.0))
	pit_pts.append(pit_ctrl[-1])

	var st_pit := SurfaceTool.new()
	st_pit.begin(Mesh.PRIMITIVE_TRIANGLES)
	var st_pit_lines := SurfaceTool.new()
	st_pit_lines.begin(Mesh.PRIMITIVE_TRIANGLES)
	var pit_hw := 4.2
	for pi in range(pit_pts.size() - 1):
		var p0 := pit_pts[pi]
		var p1 := pit_pts[pi + 1]
		var t0 := (pit_pts[mini(pi + 1, pit_pts.size() - 1)] - pit_pts[maxi(pi - 1, 0)]).normalized()
		var t1 := (pit_pts[mini(pi + 2, pit_pts.size() - 1)] - pit_pts[pi]).normalized()
		var n0 := Vector2(-t0.y, t0.x)
		var n1 := Vector2(-t1.y, t1.x)
		_add_quad_to_st(st_pit,
				Vector3(p0.x + n0.x * pit_hw, 0.022, p0.y + n0.y * pit_hw),
				Vector3(p0.x - n0.x * pit_hw, 0.022, p0.y - n0.y * pit_hw),
				Vector3(p1.x + n1.x * pit_hw, 0.022, p1.y + n1.y * pit_hw),
				Vector3(p1.x - n1.x * pit_hw, 0.022, p1.y - n1.y * pit_hw),
				0.0, 1.0, float(pi) * 0.25, float(pi + 1) * 0.25)
		for sgn: float in [-1.0, 1.0]:
			var lo := 3.75 * sgn
			var hi := 4.05 * sgn
			var e0_a := Vector3(p0.x + n0.x * lo, 0.044, p0.y + n0.y * lo)
			var e0_b := Vector3(p0.x + n0.x * hi, 0.044, p0.y + n0.y * hi)
			var e1_a := Vector3(p1.x + n1.x * lo, 0.044, p1.y + n1.y * lo)
			var e1_b := Vector3(p1.x + n1.x * hi, 0.044, p1.y + n1.y * hi)
			if sgn < 0.0:
				_add_quad_to_st(st_pit_lines, e0_a, e0_b, e1_a, e1_b, 0.0, 1.0, 0.0, 1.0)
			else:
				_add_quad_to_st(st_pit_lines, e0_b, e0_a, e1_b, e1_a, 0.0, 1.0, 0.0, 1.0)

	st_pit.index()
	var pit_mi := MeshInstance3D.new()
	pit_mi.name = "PitLane"
	pit_mi.mesh = st_pit.commit()
	pit_mi.material_override = pit_mat
	track.add_child(pit_mi)

	st_pit_lines.index()
	var pit_lines_mi := MeshInstance3D.new()
	pit_lines_mi.name = "PitEdgeLines"
	pit_lines_mi.mesh = st_pit_lines.commit()
	pit_lines_mi.material_override = pit_line
	track.add_child(pit_lines_mi)

	for apron_spec in [
		["LoopApron0", Vector3(22.0, 0.015, -78.0), Vector3(42.0, 0.03, 18.0)],
		["LoopApron1", Vector3(-22.0, 0.015, 78.0), Vector3(42.0, 0.03, 18.0)],
	]:
		var ami := MeshInstance3D.new()
		ami.name = str(apron_spec[0])
		var abm := BoxMesh.new()
		abm.size = apron_spec[2]
		abm.material = road_mat
		ami.mesh = abm
		ami.position = apron_spec[1]
		track.add_child(ami)

	# Overhead Pit Lane Steel Gantry Arch at (0, 0, 44)
	var pit_arch := Node3D.new()
	pit_arch.name = "PitGantry"
	pit_arch.position = Vector3(0.0, 0.0, 44.0)
	var gantry_dark := StandardMaterial3D.new()
	gantry_dark.albedo_color = Color(0.12, 0.14, 0.18)
	gantry_dark.metallic = 0.65
	gantry_dark.roughness = 0.38
	for pz_s: float in [-1.0, 1.0]:
		var post := MeshInstance3D.new()
		var pcm := CylinderMesh.new()
		pcm.top_radius = 0.20
		pcm.bottom_radius = 0.26
		pcm.height = 4.6
		pcm.material = gantry_dark
		post.mesh = pcm
		post.position = Vector3(0.0, 2.3, pz_s * 4.5)
		pit_arch.add_child(post)
	var beam := MeshInstance3D.new()
	var bbm := BoxMesh.new()
	bbm.size = Vector3(0.55, 0.72, 9.6)
	bbm.material = gantry_dark
	beam.mesh = bbm
	beam.position = Vector3(0.0, 4.55, 0.0)
	pit_arch.add_child(beam)
	var pit_lbl := Label3D.new()
	pit_lbl.name = "PitLaneLabel"
	pit_lbl.text = "PIT LANE · REPAIR"
	pit_lbl.font_size = 40
	pit_lbl.outline_size = 10
	pit_lbl.double_sided = false
	pit_lbl.modulate = Color(0.28, 0.92, 1.0)
	pit_lbl.position = Vector3(0.30, 4.55, 0.0)
	pit_lbl.rotation_degrees.y = 90.0
	pit_arch.add_child(pit_lbl)
	var pit_lbl_back := Label3D.new()
	pit_lbl_back.name = "PitLaneLabelBack"
	pit_lbl_back.text = "PIT LANE · REPAIR"
	pit_lbl_back.font_size = 40
	pit_lbl_back.outline_size = 10
	pit_lbl_back.double_sided = false
	pit_lbl_back.modulate = Color(0.28, 0.92, 1.0)
	pit_lbl_back.position = Vector3(-0.30, 4.55, 0.0)
	pit_lbl_back.rotation_degrees.y = -90.0
	pit_arch.add_child(pit_lbl_back)
	track.add_child(pit_arch)

	# Physical high-contrast black-and-yellow chevron turn boards along outer corners
	var chev_mat := StandardMaterial3D.new()
	chev_mat.albedo_texture = _chevron_tex()
	chev_mat.albedo_color = Color.WHITE
	chev_mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	chev_mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST

	_add_chevron_arc(track, "ChevronTurn1", pts, tangents, normals, 24, 42, 4, -1.0, chev_mat, gantry_dark)
	_add_chevron_arc(track, "ChevronSerpent", pts, tangents, normals, 62, 74, 3, -1.0, chev_mat, gantry_dark)
	_add_chevron_arc(track, "ChevronTurn2", pts, tangents, normals, 78, 92, 4, -1.0, chev_mat, gantry_dark)
	_add_chevron_arc(track, "ChevronSwitchback", pts, tangents, normals, 124, 144, 4, -1.0, chev_mat, gantry_dark)
	_add_chevron_arc(track, "ChevronTurn4", pts, tangents, normals, 162, 178, 4, -1.0, chev_mat, gantry_dark)

	# ---------------- Continuous mitered concrete jersey barriers + top rail + collision
	var walls := Node3D.new()
	walls.name = "Walls"
	root.add_child(walls)
	var wall_phys := PhysicsMaterial.new()
	wall_phys.friction = 0.04
	wall_phys.bounce = 0.10

	var concrete_mat := StandardMaterial3D.new()
	concrete_mat.albedo_color = Color(0.74, 0.73, 0.70, 1.0)
	concrete_mat.roughness = 0.88

	var rail_mat := StandardMaterial3D.new()
	rail_mat.albedo_texture = _kerb_stripe_v()
	rail_mat.albedo_color = Color.WHITE
	rail_mat.roughness = 0.65
	rail_mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	rail_mat.texture_repeat = true

	var atten_mat := _glow_panel(Color(1.0, 0.56, 0.12, 1.0), 1.25)

	var st_conc := SurfaceTool.new()
	st_conc.begin(Mesh.PRIMITIVE_TRIANGLES)
	var st_rail := SurfaceTool.new()
	st_rail.begin(Mesh.PRIMITIVE_TRIANGLES)

	var wall_off := 9.8
	for side: float in [-1.0, 1.0]:
		var wall_arc := 0.0
		var active: Array[bool] = []
		for i in range(M):
			var ni := (i + 1) % M
			var p0 := pts[i] + normals[i] * (wall_off * side)
			var p1 := pts[ni] + normals[ni] * (wall_off * side)
			var mid := (p0 + p1) * 0.5
			active.append(not _is_wall_gap(side, mid))

		for i in range(M):
			var ni := (i + 1) % M
			var p0 := pts[i] + normals[i] * (wall_off * side)
			var p1 := pts[ni] + normals[ni] * (wall_off * side)
			var seg := p1 - p0
			var slen := seg.length()
			if not active[i]:
				continue
			if not active[(i - 1 + M) % M]:
				_add_attenuator(walls, Vector3(p0.x, 0.0, p0.y), atten_mat)
			if not active[ni]:
				_add_attenuator(walls, Vector3(p1.x, 0.0, p1.y), atten_mat)

			var n0 := normals[i]
			var n1 := normals[ni]
			var ru0 := wall_arc / 3.0
			var ru1 := (wall_arc + slen) / 3.0
			wall_arc += slen

			# Tapered concrete jersey profile: base half-width 0.39, top half-width 0.21, height 1.15
			var b0_in := Vector3(p0.x - n0.x * 0.39, 0.0, p0.y - n0.y * 0.39)
			var b0_out := Vector3(p0.x + n0.x * 0.39, 0.0, p0.y + n0.y * 0.39)
			var b1_in := Vector3(p1.x - n1.x * 0.39, 0.0, p1.y - n1.y * 0.39)
			var b1_out := Vector3(p1.x + n1.x * 0.39, 0.0, p1.y + n1.y * 0.39)
			var t0_in := Vector3(p0.x - n0.x * 0.21, 1.15, p0.y - n0.y * 0.21)
			var t0_out := Vector3(p0.x + n0.x * 0.21, 1.15, p0.y + n0.y * 0.21)
			var t1_in := Vector3(p1.x - n1.x * 0.21, 1.15, p1.y - n1.y * 0.21)
			var t1_out := Vector3(p1.x + n1.x * 0.21, 1.15, p1.y + n1.y * 0.21)

			var nin := Vector3(-n0.x, 0.0, -n0.y)
			var nout := Vector3(n0.x, 0.0, n0.y)
			_add_quad_to_st(st_conc, b0_in, t0_in, b1_in, t1_in, 0.0, 1.0, ru0, ru1, nin)
			_add_quad_to_st(st_conc, t0_out, b0_out, t1_out, b1_out, 0.0, 1.0, ru0, ru1, nout)
			_add_quad_to_st(st_conc, t0_in, t0_out, t1_in, t1_out, 0.0, 1.0, ru0, ru1, Vector3.UP)

			# Red/white striped safety top rail (y = 1.15 .. 1.48)
			var r0_in := Vector3(p0.x - n0.x * 0.23, 1.15, p0.y - n0.y * 0.23)
			var r0_out := Vector3(p0.x + n0.x * 0.23, 1.15, p0.y + n0.y * 0.23)
			var r1_in := Vector3(p1.x - n1.x * 0.23, 1.15, p1.y - n1.y * 0.23)
			var r1_out := Vector3(p1.x + n1.x * 0.23, 1.15, p1.y + n1.y * 0.23)
			var rt0_in := Vector3(p0.x - n0.x * 0.23, 1.48, p0.y - n0.y * 0.23)
			var rt0_out := Vector3(p0.x + n0.x * 0.23, 1.48, p0.y + n0.y * 0.23)
			var rt1_in := Vector3(p1.x - n1.x * 0.23, 1.48, p1.y - n1.y * 0.23)
			var rt1_out := Vector3(p1.x + n1.x * 0.23, 1.48, p1.y + n1.y * 0.23)
			_add_quad_to_st(st_rail, r0_in, rt0_in, r1_in, rt1_in, 0.0, 1.0, ru0, ru1, nin)
			_add_quad_to_st(st_rail, rt0_out, r0_out, rt1_out, r1_out, 0.0, 1.0, ru0, ru1, nout)
			_add_quad_to_st(st_rail, rt0_in, rt0_out, rt1_in, rt1_out, 0.0, 1.0, ru0, ru1, Vector3.UP)

		# Invisible collision-only wall segments every 2 samples
		for i in range(0, M, 2):
			var ni := (i + 2) % M
			var p0 := pts[i] + normals[i] * (wall_off * side)
			var p1 := pts[ni] + normals[ni] * (wall_off * side)
			var mid := (p0 + p1) * 0.5
			if _is_wall_gap(side, mid):
				continue
			var seg := p1 - p0
			var slen := seg.length()
			if slen < 0.2:
				continue
			var sb := StaticBody3D.new()
			sb.name = "TrackWall_%s_%d" % ["Out" if side < 0.0 else "In", i]
			sb.physics_material_override = wall_phys
			sb.position = Vector3(mid.x, 0.85, mid.y)
			sb.rotation.y = -atan2(seg.y, seg.x)
			var col := CollisionShape3D.new()
			var sh := BoxShape3D.new()
			sh.size = Vector3(slen + 0.35, 1.7, 0.85)
			col.shape = sh
			sb.add_child(col)
			walls.add_child(sb)

	st_conc.index()
	var conc_mi := MeshInstance3D.new()
	conc_mi.name = "BarrierConcrete"
	conc_mi.mesh = st_conc.commit()
	conc_mi.material_override = concrete_mat
	walls.add_child(conc_mi)

	st_rail.index()
	var rail_mi := MeshInstance3D.new()
	rail_mi.name = "BarrierTopRail"
	rail_mi.mesh = st_rail.commit()
	rail_mi.material_override = rail_mat
	walls.add_child(rail_mi)

	# Backstops behind stunt loops & clean inner pit divider with end attenuators
	var aux_walls := [
		["LoopBackstop0", Vector3(22.0, 0.8, -88.0), Vector3(44.0, 1.6, 1.0)],
		["LoopBackstop1", Vector3(-22.0, 0.8, 88.0), Vector3(44.0, 1.6, 1.0)],
		["InnerPitWall", Vector3(0.0, 0.72, 51.8), Vector3(32.0, 1.44, 0.85)],
	]
	for aw in aux_walls:
		var sb := StaticBody3D.new()
		sb.name = str(aw[0])
		sb.physics_material_override = wall_phys
		sb.position = aw[1]
		var col := CollisionShape3D.new()
		var sh := BoxShape3D.new()
		sh.size = aw[2]
		col.shape = sh
		sb.add_child(col)
		var mi := MeshInstance3D.new()
		var bm := BoxMesh.new()
		bm.size = aw[2]
		bm.material = concrete_mat
		mi.mesh = bm
		sb.add_child(mi)
		walls.add_child(sb)
	_add_attenuator(walls, Vector3(-16.0, 0.0, 51.8), atten_mat)
	_add_attenuator(walls, Vector3(16.0, 0.0, 51.8), atten_mat)

	# Tall collision-only perimeter containment walls so no jump/dodge can exit into the void
	var contain_specs := [
		["ContainmentN", Vector3(0.0, 14.0, -98.0), Vector3(244.0, 28.0, 2.0)],
		["ContainmentS", Vector3(0.0, 14.0, 98.0), Vector3(244.0, 28.0, 2.0)],
		["ContainmentE", Vector3(118.0, 14.0, 0.0), Vector3(2.0, 28.0, 200.0)],
		["ContainmentW", Vector3(-118.0, 14.0, 0.0), Vector3(2.0, 28.0, 200.0)],
	]
	for cw in contain_specs:
		var sb := StaticBody3D.new()
		sb.name = str(cw[0])
		sb.physics_material_override = wall_phys
		sb.position = cw[1]
		var col := CollisionShape3D.new()
		var sh := BoxShape3D.new()
		sh.size = cw[2]
		col.shape = sh
		sb.add_child(col)
		walls.add_child(sb)


