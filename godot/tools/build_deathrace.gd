	finish.collision_layer = 0
	finish.collision_mask = 1
	finish.monitoring = true
	finish.monitorable = false
	finish.add_to_group("finish_line", true)

	var col := CollisionShape3D.new()
	col.name = "Trigger"
	var shape := BoxShape3D.new()
	shape.size = Vector3(18.0, 6.0, 2.5)
	col.shape = shape
	col.position = Vector3(0.0, 3.0, 0.0)
	finish.add_child(col)

	var pillar_mat := StandardMaterial3D.new()
	pillar_mat.albedo_color = Color(0.14, 0.16, 0.20)
	pillar_mat.metallic = 0.65
	pillar_mat.roughness = 0.35

	var check_mat := StandardMaterial3D.new()
