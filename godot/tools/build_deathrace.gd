func _add_ramp(root: Node, ramp_name: String, pos: Vector3, rot_deg: Vector3,
		width := 2.7, double_sided := false) -> void:
	var theta: float = abs(deg_to_rad(rot_deg.x))
	var rot_x: float = -rot_deg.x
	var half_len := 1.75
	var plank_c := sin(theta) * half_len + 0.06
	var stand_h := sin(theta) * 2.0 * half_len * 0.82
	var stand_z := cos(theta) * (half_len * 0.78)

	var ramp := StaticBody3D.new()
	ramp.name = ramp_name

	var plank_shape := BoxShape3D.new()
	plank_shape.size = Vector3(width, 0.16, 3.5)
	var col1 := CollisionShape3D.new()
	col1.shape = plank_shape
	col1.position = Vector3(0.0, plank_c, 0.0)
	col1.rotation_degrees = Vector3(rot_x, 0.0, 0.0)
	ramp.add_child(col1)

	var plank_mesh := BoxMesh.new()
	plank_mesh.size = plank_shape.size
	var plank_mat := StandardMaterial3D.new()
	plank_mat.albedo_color = Color(0.17, 0.17, 0.19, 1)
	plank_mat.roughness = 0.82
	plank_mesh.material = plank_mat
	var mesh1 := MeshInstance3D.new()
	mesh1.mesh = plank_mesh
	mesh1.position = col1.position
	mesh1.rotation_degrees = Vector3(rot_x, 0.0, 0.0)
	ramp.add_child(mesh1)

	# Glowing amber launch lip + yellow deck guide rails so ramps pop at speed
	var lip_mat := _glow_panel(Color(1.0, 0.76, 0.16, 1.0), 1.4)
	var lip := MeshInstance3D.new()
	var lbm := BoxMesh.new()
	lbm.size = Vector3(width, 0.08, 0.18)
	lbm.material = lip_mat
	lip.mesh = lbm
	lip.position = Vector3(0.0, sin(theta) * 2.0 * half_len + 0.05, cos(theta) * half_len)
	ramp.add_child(lip)

	for sx: float in [-1.0, 1.0]:
		var stripe := MeshInstance3D.new()
		var sbm := BoxMesh.new()
		sbm.size = Vector3(0.18, 0.04, 3.3)
		sbm.material = lip_mat
		stripe.mesh = sbm
		stripe.position = col1.position + Vector3(sx * (width * 0.42), 0.09, 0.0)
		stripe.rotation_degrees = Vector3(rot_x, 0.0, 0.0)
		ramp.add_child(stripe)

	if double_sided:
		var back_col := CollisionShape3D.new()
		back_col.shape = plank_shape
		back_col.position = Vector3(0.0, plank_c, cos(theta) * 2.7)
		back_col.rotation_degrees = Vector3(-rot_x, 0.0, 0.0)
		ramp.add_child(back_col)
		var back_mesh := MeshInstance3D.new()
		back_mesh.mesh = plank_mesh
		back_mesh.position = back_col.position
		back_mesh.rotation_degrees = back_col.rotation_degrees
		ramp.add_child(back_mesh)
	else:
		var stand_shape := BoxShape3D.new()
		stand_shape.size = Vector3(width, stand_h, 0.34)
		var col2 := CollisionShape3D.new()
		col2.shape = stand_shape
		col2.position = Vector3(0.0, stand_h * 0.5, stand_z)
		ramp.add_child(col2)
		var stand_mesh := BoxMesh.new()
		stand_mesh.size = stand_shape.size
		var stand_mat := StandardMaterial3D.new()
		stand_mat.albedo_color = Color(0.80, 0.62, 0.10, 1)
		stand_mat.roughness = 0.6
		stand_mesh.material = stand_mat
		var mesh2 := MeshInstance3D.new()
		mesh2.mesh = stand_mesh
		mesh2.position = col2.position
		ramp.add_child(mesh2)

	ramp.position = Vector3(pos.x, 0.0, pos.z)
	ramp.rotation_degrees.y = rot_deg.y
	root.add_child(ramp)


func _spline_pt(pts: Array[Vector2], frac: float, lat_offset: float = 0.0) -> Vector3:
	var M := pts.size()
	var idx := posmod(int(roundf(frac * float(M))), M)
	var a := pts[(idx - 1 + M) % M]
	var c := pts[(idx + 1) % M]
	var t := (c - a).normalized()
	var n := Vector2(-t.y, t.x)
	var p := pts[idx] + n * lat_offset
	return Vector3(p.x, 0.0, p.y)


func _add_pickups(root: Node, pts: Array[Vector2]) -> void:
	var specs := [
		["PickupOverdrive0", "overdrive", Vector3(12.0, 0.7, -62.0)],
		["PickupRapid0", "rapid", _spline_pt(pts, 0.16) + Vector3(0.0, 0.7, 0.0)],
		["PickupShield0", "shield", Vector3(88.0, 0.7, -18.0)],
		["PickupRepair0", "repair", _spline_pt(pts, 0.38) + Vector3(0.0, 0.7, 0.0)],
		["PickupOverdrive1", "overdrive", _spline_pt(pts, 0.48) + Vector3(0.0, 0.7, 0.0)],
		["PickupRepairPit0", "repair", Vector3(6.0, 0.7, 44.0)],
		["PickupOverdrivePit0", "overdrive", Vector3(-6.0, 0.7, 44.0)],
		["PickupShield1", "shield", _spline_pt(pts, 0.67) + Vector3(0.0, 0.7, 0.0)],
		["PickupRapid1", "rapid", _spline_pt(pts, 0.77) + Vector3(0.0, 0.7, 0.0)],
		["PickupRepair1", "repair", _spline_pt(pts, 0.92) + Vector3(0.0, 0.7, 0.0)],
	]
	for spec in specs:
		var pickup := Area3D.new()
		pickup.name = str(spec[0])
		pickup.set_script(load(PICKUP))
		pickup.set("kind", str(spec[1]))
		pickup.position = spec[2]
		root.add_child(pickup)


func _add_fuel_drums(root: Node, pts: Array[Vector2]) -> void:
	var drum_placements := [
		[0.35, -5.0], [0.355, -3.6],
		[0.44, 5.0], [0.445, 3.6],
		[0.73, -5.0], [0.735, -3.6],
		[0.80, 5.0], [0.805, 3.6],
	]
	for idx in range(drum_placements.size()):
		var dp: Array = drum_placements[idx]
		var pos := _spline_pt(pts, float(dp[0]), float(dp[1])) + Vector3(0.0, 0.45, 0.0)
		var drum := StaticBody3D.new()
		drum.name = "FuelDrum%d" % idx
		drum.set_script(load(FUEL_DRUM))
		drum.add_to_group("hazard", true)
		drum.position = pos
		root.add_child(drum)


func _add_building(root: Node, node_name: String, display_name: String,
		pos: Vector3, size: Vector3, color: Color) -> void:
	var b := StaticBody3D.new()
	b.name = node_name
	b.position = pos
	b.set_script(load(BUILDING))
	b.set("building_name", display_name)
	b.add_to_group("destructible", true)

	var col := CollisionShape3D.new()
	var box_s := BoxShape3D.new()
	box_s.size = size
	col.shape = box_s
	col.position = Vector3(0.0, size.y * 0.5, 0.0)
	b.add_child(col)

	var facade_path := "res://assets/tex_facade_garage.jpg" if node_name == "PitGarage" else "res://assets/tex_facade_store.png"
	var facade := load(facade_path) as Texture2D
	var mi := MeshInstance3D.new()
	mi.name = "MainBlock"
	var bm := BoxMesh.new()
	bm.size = size
	var mat := StandardMaterial3D.new()
	if facade != null:
		mat.albedo_texture = facade
		mat.albedo_color = Color.WHITE
	else:
		mat.albedo_color = color
	mat.roughness = 0.85
	bm.material = mat
	mi.mesh = bm
	mi.position = Vector3(0.0, size.y * 0.5, 0.0)
	b.add_child(mi)

	var roof_mesh := BoxMesh.new()
	roof_mesh.size = Vector3(size.x + 0.5, 0.28, size.z + 0.5)
	var roof_mat := StandardMaterial3D.new()
	roof_mat.albedo_color = Color(0.22, 0.23, 0.24, 1)
	roof_mat.roughness = 0.8
	roof_mesh.material = roof_mat
	var roof_inst := MeshInstance3D.new()
	roof_inst.name = "Roof"
	roof_inst.mesh = roof_mesh
	roof_inst.position = Vector3(0.0, size.y + 0.14, 0.0)
	b.add_child(roof_inst)

	DECOR.dress(b, size, display_name)
	root.add_child(b)


