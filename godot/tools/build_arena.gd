extends SceneTree
# Builds res://scenes/Arena.tscn - the 100x100 m multiplayer combat arena:
# asphalt floor, low kerb walls, ramps, cover blocks, destructible buildings,
# 8 spawn points, the local bike + CombatController, follow camera, ArenaNet,
# the match HUD and the touch overlay (incl. a large FIRE button).
# Scenes are generated by builder scripts only - never hand-edited.

const OUT := "res://scenes/Arena.tscn"
const MATCH_HUD := "res://src/ui/MatchHud.gd"
const COMBAT := "res://src/game/CombatController.gd"
const FOLLOW_CAM := "res://src/FollowCam.gd"
const ARENA_NET := "res://src/game/ArenaNet.gd"
const BUILDING := "res://src/DestructibleBuilding.gd"
const PICKUP := "res://src/game/Pickup.gd"
const FUEL_DRUM := "res://src/game/FuelDrum.gd"
const AMBIENT := "res://src/game/AmbientVfx.gd"
const DECOR := preload("res://src/game/BuildingDecor.gd")
const UI := preload("res://src/ui/UiTheme.gd")


func _chip(bg := Color(0.075, 0.085, 0.105, 0.80),
		border := Color(1.0, 1.0, 1.0, 0.08)) -> StyleBoxFlat:
	return UI.chip(bg, border, 12)


func _style_button(btn: Button, accent: Color) -> void:
	UI.style_button(btn, accent, 15, 44.0)


func _outlined(label: Label, color: Color, size: int, outline := 6) -> void:
	label.add_theme_font_size_override("font_size", size)
	label.add_theme_color_override("font_color", color)
	label.add_theme_constant_override("outline_size", outline)
	label.add_theme_color_override("font_outline_color", Color(0.0, 0.0, 0.0, 0.92))


func _initialize() -> void:
	var root := Node3D.new()
	root.name = "Arena"

	# ---------------- environment (tighter, punchier than TestRide)
	var sky_mat := ProceduralSkyMaterial.new()
	sky_mat.sky_top_color = Color(0.09, 0.16, 0.34, 1)
	sky_mat.sky_horizon_color = Color(0.40, 0.55, 0.68, 1)
	sky_mat.ground_horizon_color = Color(0.30, 0.33, 0.36, 1)
	sky_mat.ground_bottom_color = Color(0.14, 0.13, 0.12, 1)
	sky_mat.sun_angle_max = 26.0
	sky_mat.sun_curve = 0.18
	var sky_res := Sky.new()
	sky_res.sky_material = sky_mat
	var env := Environment.new()
	env.background_mode = 2
	env.sky = sky_res
	env.ambient_light_source = 3
	env.ambient_light_sky_contribution = 0.60
	env.ambient_light_color = Color(0.72, 0.80, 0.88, 1)
	env.ambient_light_energy = 0.70
	env.fog_enabled = true
	env.fog_light_color = Color(0.30, 0.38, 0.44, 1)
	env.fog_density = 0.0022
	env.tonemap_mode = 3
	env.tonemap_exposure = 1.20
	var world_env := WorldEnvironment.new()
	world_env.environment = env
	root.add_child(world_env)

	# ---------------- sun
	var sun := DirectionalLight3D.new()
	sun.name = "Sun"
	sun.light_energy = 1.8
	sun.light_color = Color(1.0, 0.96, 0.88, 1)
	sun.shadow_enabled = true
	sun.directional_shadow_max_distance = 120.0
	sun.rotation_degrees = Vector3(-52.0, 28.0, 0.0)
	root.add_child(sun)

	# ---------------- asphalt floor (100 x 100 m)
	var ground := StaticBody3D.new()
	ground.name = "Ground"
	var ground_col := CollisionShape3D.new()
	var ground_shape := BoxShape3D.new()
	ground_shape.size = Vector3(100.0, 1.0, 100.0)
	ground_col.shape = ground_shape
	ground.add_child(ground_col)
	var ground_mesh := MeshInstance3D.new()
	var box := BoxMesh.new()
	box.size = Vector3(100.0, 1.0, 100.0)
	var asphalt := StandardMaterial3D.new()
	var asphalt_tex := load("res://assets/tex_asphalt.png") as Texture2D
	asphalt.albedo_texture = asphalt_tex
	asphalt.albedo_color = Color(0.80, 0.82, 0.86, 1)
	asphalt.roughness = 0.96
	asphalt.uv1_scale = Vector3(50.0, 50.0, 1.0)
	box.material = asphalt
	ground_mesh.mesh = box
	ground.add_child(ground_mesh)
	ground.position = Vector3(0.0, -0.5, 0.0)
	root.add_child(ground)

	# ---------------- outside-the-walls venue silhouette (visual only)
	_add_backdrop(root)

	# ---------------- low kerb walls at the four edges
	var walls := Node3D.new()
	walls.name = "Walls"
	_add_wall(walls, "KerbN", Vector3(0.0, 0.75, -50.0), Vector3(101.0, 1.5, 1.0))
	_add_wall(walls, "KerbS", Vector3(0.0, 0.75, 50.0), Vector3(101.0, 1.5, 1.0))
	_add_wall(walls, "KerbW", Vector3(-50.0, 0.75, 0.0), Vector3(1.0, 1.5, 101.0))
	_add_wall(walls, "KerbE", Vector3(50.0, 0.75, 0.0), Vector3(1.0, 1.5, 101.0))
	root.add_child(walls)

	# ---------------- ramps — two gap-jump lines plus two cover hops
	_add_ramp(root, "RampA", Vector3(-10.0, 0.0, 0.0), Vector3(14.0, 0.0, 0.0))
	_add_ramp(root, "RampB", Vector3(10.0, 0.0, 3.0), Vector3(14.0, 180.0, 0.0))
	_add_ramp(root, "RampC", Vector3(0.0, 0.0, -12.0), Vector3(14.0, 90.0, 0.0))
	_add_ramp(root, "RampD", Vector3(0.0, 0.0, 12.0), Vector3(14.0, 270.0, 0.0))
	# north line: launch -Z at z=34, land on the down-slope at z=20
	_add_ramp(root, "RampGapN", Vector3(-15.0, 0.0, 34.0), Vector3(16.0, 180.0, 0.0))
	_add_ramp(root, "RampLandN", Vector3(-15.0, 0.0, 23.0), Vector3(10.0, 0.0, 0.0))
	# south line: mirror, launch +Z at z=-34, land at z=-20
	_add_ramp(root, "RampGapS", Vector3(15.0, 0.0, -34.0), Vector3(16.0, 0.0, 0.0))
	_add_ramp(root, "RampLandS", Vector3(15.0, 0.0, -23.0), Vector3(10.0, 180.0, 0.0))
	# cover hops: kicker aimed over CoverA / CoverB
	_add_ramp(root, "RampHopW", Vector3(-31.0, 0.0, 10.0), Vector3(13.0, 90.0, 0.0))
	_add_ramp(root, "RampHopE", Vector3(31.0, 0.0, -10.0), Vector3(13.0, 270.0, 0.0))

	# ---------------- cover blocks
	_add_cover(root, "CoverA", Vector3(-22.0, 0.9, 8.0), Vector3(3.0, 1.8, 3.0))
	_add_cover(root, "CoverB", Vector3(22.0, 0.9, -8.0), Vector3(3.0, 1.8, 3.0))
	_add_cover(root, "CoverC", Vector3(6.0, 0.9, 24.0), Vector3(4.0, 1.8, 2.0))
	_add_cover(root, "CoverD", Vector3(-6.0, 0.9, -24.0), Vector3(4.0, 1.8, 2.0))
	_add_cover(root, "CoverE", Vector3(30.0, 0.9, 22.0), Vector3(2.5, 1.8, 4.0))
	_add_cover(root, "CoverF", Vector3(-30.0, 0.9, -22.0), Vector3(2.5, 1.8, 4.0))

	# ---------------- destructible buildings
	_add_building(root, "Workshop", "Workshop",
			Vector3(-16.0, 0.0, 16.0), Vector3(6.5, 3.4, 5.0), Color(0.44, 0.31, 0.25))
	_add_building(root, "Shed", "Shed",
			Vector3(16.0, 0.0, -16.0), Vector3(4.2, 2.3, 3.6), Color(0.55, 0.55, 0.55))
	_add_building(root, "Store", "Store",
			Vector3(-16.0, 0.0, -16.0), Vector3(4.8, 4.6, 4.2), Color(0.30, 0.37, 0.47))
	_add_building(root, "Depot", "Depot",
			Vector3(16.0, 0.0, 16.0), Vector3(5.5, 3.0, 5.0), Color(0.35, 0.40, 0.45))
	# outer compounds — three corners, SW left open as a high-speed lane
	_add_building(root, "Garage", "Garage",
			Vector3(-34.0, 0.0, 34.0), Vector3(5.4, 3.4, 4.6), Color(0.48, 0.44, 0.38))
	_add_building(root, "Warehouse", "Warehouse",
			Vector3(34.0, 0.0, 34.0), Vector3(7.2, 4.8, 5.6), Color(0.40, 0.46, 0.50))
	_add_building(root, "Freight", "Freight Depot",
			Vector3(34.0, 0.0, -34.0), Vector3(6.0, 3.6, 5.0), Color(0.38, 0.40, 0.42))

	# ---------------- ambient dust motes (one emitter, no per-frame work)
	var ambient := Node3D.new()
	ambient.name = "AmbientVfx"
	ambient.set_script(load(AMBIENT))
	root.add_child(ambient)

	# ---------------- pickups + explosive fuel drums
	_add_pickups(root)
	_add_fuel_drums(root)

	# ---------------- 8 spawn points (ring), each in group "spawn_point"
	for i in range(8):
		var a := TAU * float(i) / 8.0
		var sp := Node3D.new()
		sp.name = "SpawnPoint%d" % i
		sp.position = Vector3(cos(a) * 38.0, 0.0, sin(a) * 38.0)
		sp.rotation.y = atan2(-sp.position.x, -sp.position.z)  # face arena centre
		sp.add_to_group("spawn_point", true)  # persistent so it survives packing
		root.add_child(sp)

	# ---------------- local bike + CombatController
	var bike_scene: PackedScene = load("res://scenes/KiepieBike.tscn")
	var bike := bike_scene.instantiate()
	bike.name = "KiepieBike"
	var sp0 := root.get_node("SpawnPoint0") as Node3D
	bike.position = sp0.position + Vector3(0.0, 0.6, 0.0)
	bike.rotation = sp0.rotation
	bike.add_to_group("bike", true)  # persisted on the instance; KiepieBike.gd also adds it at runtime
	var combat := Node3D.new()
	combat.name = "CombatController"
	combat.set_script(load(COMBAT))
	bike.add_child(combat)
	root.add_child(bike)
	combat.owner = root  # an added child of an instanced scene is owned by the OUTER scene root;
	                     # owner = bike would be dropped when packing (verified in Godot 4.3)

	# ---------------- camera rig + camera
	var rig := Node3D.new()
	rig.name = "CameraRig"
	rig.position = Vector3(33.0, 2.2, 0.0)
	var cam := Camera3D.new()
	cam.name = "Camera3D"
	cam.current = true
	cam.fov = 62.0
	rig.add_child(cam)
	rig.set_script(load(FOLLOW_CAM))
	rig.set("target_path", NodePath("../KiepieBike"))
	root.add_child(rig)

	# ---------------- networking bridge
	var net := Node3D.new()
	net.name = "ArenaNet"
	net.set_script(load(ARENA_NET))
	net.set("local_bike_path", NodePath("../KiepieBike"))
	root.add_child(net)

	# ---------------- match HUD
	_add_match_hud(root)

	# ---------------- touch controls (mobile), incl. large FIRE button
	_add_touch_controls(root)

	# ---------------- save (own the instance, never its children)
	for child in root.get_children():
		child.owner = root
		if child.name != "KiepieBike":
			_set_owners(child, root)
	var scene := PackedScene.new()
	if scene.pack(root) != OK:
		printerr("pack failed")
		quit(1)
		return
	if ResourceSaver.save(scene, OUT) != OK:
		printerr("save failed")
		quit(1)
		return
	print("saved ", OUT)
	quit()


func _set_owners(node: Node, owner: Node) -> void:
	for child in node.get_children():
		child.owner = owner
		_set_owners(child, owner)


