# ---------------------------------------------------------- touch controls ---

func _add_touch_controls(root: Node) -> void:
	# Shared builder (tools/TouchOverlayKit.gd) — preset "arena".
	(load("res://tools/TouchOverlayKit.gd") as GDScript).build(root, "arena")


# ----------------------------------------------------------------- pickups ---

func _add_pickups(root: Node) -> void:
	# 2 of each kind, spread across the open lanes between cover/buildings and
	# clear of the spawn ring (radius 38) and building interiors.
	var specs := [
		["PickupShield0", "shield", Vector3(-6.0, 0.7, 6.0)],
		["PickupShield1", "shield", Vector3(28.0, 0.7, 0.0)],
		["PickupRapid0", "rapid", Vector3(6.0, 0.7, -6.0)],
		["PickupRapid1", "rapid", Vector3(-28.0, 0.7, 0.0)],
		["PickupRepair0", "repair", Vector3(0.0, 0.7, 30.0)],
		["PickupRepair1", "repair", Vector3(0.0, 0.7, -30.0)],
		["PickupOverdrive0", "overdrive", Vector3(10.0, 0.7, 30.0)],
		["PickupOverdrive1", "overdrive", Vector3(-10.0, 0.7, -30.0)],
	]
	for spec in specs:
		var pickup := Area3D.new()
		pickup.name = str(spec[0])
		pickup.set_script(load(PICKUP))
		pickup.set("kind", str(spec[1]))
		pickup.position = spec[2]
		root.add_child(pickup)


# --------------------------------------------------------------- fuel drums ---

func _add_fuel_drums(root: Node) -> void:
	# 5 tight pairs near cover/ramps. Pair spacing (~1.2 m) is well inside the
	# 4 m blast radius so a pair chains; the clusters are far apart so the chain
	# stays local. The script builds the collider + emissive mesh in _ready.
	var specs := [
		["FuelDrum0", Vector3(-19.5, 0.45, 9.5)],    # CoverA
		["FuelDrum1", Vector3(-18.3, 0.45, 9.0)],
		["FuelDrum2", Vector3(-13.5, 0.45, -3.0)],   # RampA
		["FuelDrum3", Vector3(-12.3, 0.45, -3.8)],
		["FuelDrum4", Vector3(23.8, 0.45, -10.2)],   # CoverB
		["FuelDrum5", Vector3(25.0, 0.45, -9.8)],
		["FuelDrum6", Vector3(3.5, 0.45, -13.5)],    # RampC
		["FuelDrum7", Vector3(4.7, 0.45, -14.2)],
		["FuelDrum8", Vector3(28.0, 0.45, 24.5)],    # CoverE
		["FuelDrum9", Vector3(29.2, 0.45, 25.2)],
	]
	for spec in specs:
		var drum := StaticBody3D.new()
		drum.name = str(spec[0])
		drum.set_script(load(FUEL_DRUM))
		drum.add_to_group("hazard", true)  # persist group through PackedScene.pack()
		drum.position = spec[1]
		root.add_child(drum)


# ------------------------------------------------------------------- walls ---

func _glow_panel(color: Color, energy: float) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = color
	m.emission_enabled = true
	m.emission = color
	m.emission_energy_multiplier = energy
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	return m


func _add_backdrop(root: Node3D) -> void:
	## Outside the playable walls: floodlight towers + hangar silhouettes.
	## Visual only (no colliders), so shots and bikes never interact with them.
	var backdrop := Node3D.new()
	backdrop.name = "Backdrop"
	var lamp := _glow_panel(Color(1.0, 0.93, 0.72, 1), 3.2)
	var dark := StandardMaterial3D.new()
	dark.albedo_color = Color(0.11, 0.13, 0.16, 1)
	dark.roughness = 0.95
	var win := _glow_panel(Color(0.32, 0.56, 0.72, 1), 1.2)
	for sx in [-1.0, 1.0]:
		for sz in [-1.0, 1.0]:
			var tower := Node3D.new()
			tower.name = "Floodlight_%d_%d" % [int(sx), int(sz)]
			var mast := BoxMesh.new()
			mast.size = Vector3(0.55, 17.0, 0.55)
			mast.material = dark
			var mast_inst := MeshInstance3D.new()
			mast_inst.mesh = mast
			mast_inst.position = Vector3(0, 8.5, 0)
			tower.add_child(mast_inst)
			var bar := BoxMesh.new()
			bar.size = Vector3(4.4, 0.35, 0.6)
			bar.material = dark
			var bar_inst := MeshInstance3D.new()
			bar_inst.mesh = bar
			bar_inst.position = Vector3(0, 16.8, 0)
			tower.add_child(bar_inst)
			for i in range(4):
				var panel := BoxMesh.new()
				panel.size = Vector3(0.9, 0.5, 0.12)
				panel.material = lamp
				var p := MeshInstance3D.new()
				p.mesh = panel
				p.position = Vector3(-1.55 + float(i) * 1.03, 16.8, 0.34)
				tower.add_child(p)
			tower.position = Vector3(sx * 57.0, 0.0, sz * 57.0)
			backdrop.add_child(tower)
	var rng := RandomNumberGenerator.new()
	rng.seed = 90210
	for i in range(9):
		var a := TAU * float(i) / 9.0 + 0.18
		var r := rng.randf_range(68.0, 86.0)
		var h := rng.randf_range(5.0, 11.0)
		var w := rng.randf_range(9.0, 16.0)
		var hangar := Node3D.new()
		hangar.name = "Hangar%d" % i
		var body := BoxMesh.new()
		body.size = Vector3(w, h, w * 0.7)
		body.material = dark
		var bi := MeshInstance3D.new()
		bi.mesh = body
		bi.position.y = h * 0.5
		hangar.add_child(bi)
		var strip := BoxMesh.new()
		strip.size = Vector3(w * 0.7, 0.22, 0.05)
		strip.material = win
		var si := MeshInstance3D.new()
		si.mesh = strip
		si.position = Vector3(0, h * 0.62, w * 0.35 + 0.03)
		hangar.add_child(si)
		hangar.position = Vector3(cos(a) * r, 0.0, sin(a) * r)
		hangar.rotation.y = -a
		backdrop.add_child(hangar)
	root.add_child(backdrop)


static var _kerb_tex: ImageTexture = null

func _kerb_stripe() -> ImageTexture:
	## Two-pixel texture replaces 20 alternating box meshes per wall —
	## 4 draw calls for the whole perimeter instead of 80.
	if _kerb_tex == null:
		var img := Image.create(2, 1, false, Image.FORMAT_RGB8)
		img.set_pixel(0, 0, Color(0.78, 0.14, 0.12, 1))
		img.set_pixel(1, 0, Color(0.90, 0.90, 0.88, 1))
		_kerb_tex = ImageTexture.create_from_image(img)
	return _kerb_tex


func _add_wall(parent: Node, wall_name: String, pos: Vector3, size: Vector3) -> void:
	var body := StaticBody3D.new()
	body.name = wall_name
	var col := CollisionShape3D.new()
	var shape := BoxShape3D.new()
	shape.size = size
	col.shape = shape
	body.add_child(col)
	var mat := StandardMaterial3D.new()
	mat.albedo_texture = _kerb_stripe()
	mat.albedo_color = Color.WHITE
	mat.roughness = 0.72
	mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	mat.texture_repeat = true
	var bm := BoxMesh.new()
	bm.size = size
	bm.material = mat
	mat.uv1_scale = Vector3(maxf(1.0, maxf(size.x, size.z) / 5.0), 1.0, 1.0)
	var m := MeshInstance3D.new()
	m.mesh = bm
	body.add_child(m)
	body.position = pos
	parent.add_child(body)


func _add_cover(root: Node, cover_name: String, pos: Vector3, size: Vector3) -> void:
	var body := StaticBody3D.new()
	body.name = cover_name
	var col := CollisionShape3D.new()
	var shape := BoxShape3D.new()
	shape.size = size
	col.shape = shape
	body.add_child(col)
	var mesh := BoxMesh.new()
	mesh.size = size
	var mat := StandardMaterial3D.new()
	mat.albedo_color = Color(0.32, 0.35, 0.39, 1)
	mat.roughness = 0.9
	mesh.material = mat
	var inst := MeshInstance3D.new()
	inst.mesh = mesh
	body.add_child(inst)
	body.position = pos
	root.add_child(body)


# ------------------------------------------------------------------- ramps ---

func _add_ramp(root: Node, ramp_name: String, pos: Vector3, rot_deg: Vector3) -> void:
	var theta: float = abs(deg_to_rad(rot_deg.x))
	var rot_x: float = -rot_deg.x
	var half_len := 1.75
	var plank_c := sin(theta) * half_len + 0.06
	var stand_h := sin(theta) * 2.0 * half_len * 0.82
	var stand_z := cos(theta) * (half_len * 0.78)

	var ramp := StaticBody3D.new()
	ramp.name = ramp_name

	var plank_shape := BoxShape3D.new()
	plank_shape.size = Vector3(2.7, 0.16, 3.5)
	var col1 := CollisionShape3D.new()
	col1.shape = plank_shape
	col1.position = Vector3(0.0, plank_c, 0.0)
	col1.rotation_degrees = Vector3(rot_x, 0.0, 0.0)
	ramp.add_child(col1)

	var stand_shape := BoxShape3D.new()
	stand_shape.size = Vector3(2.7, stand_h, 0.34)
	var col2 := CollisionShape3D.new()
	col2.shape = stand_shape
	col2.position = Vector3(0.0, stand_h * 0.5, stand_z)
	ramp.add_child(col2)

	var plank_mesh := BoxMesh.new()
	plank_mesh.size = plank_shape.size
	var plank_mat := StandardMaterial3D.new()
	plank_mat.albedo_color = Color(0.17, 0.17, 0.18, 1)
	plank_mat.roughness = 0.82
	plank_mesh.material = plank_mat
	var mesh1 := MeshInstance3D.new()
	mesh1.mesh = plank_mesh
	mesh1.position = col1.position
	mesh1.rotation_degrees = Vector3(rot_x, 0.0, 0.0)
	ramp.add_child(mesh1)

	var stand_mesh := BoxMesh.new()
	stand_mesh.size = stand_shape.size
	var stand_mat := StandardMaterial3D.new()
	stand_mat.albedo_color = Color(0.80, 0.62, 0.10, 1)
	stand_mat.roughness = 0.6
	stand_mesh.material = stand_mat
	var mesh2 := MeshInstance3D.new()
	mesh2.mesh = stand_mesh
	mesh2.position = col2.position
	ramp.add_child(mesh2)

	var stripe := MeshInstance3D.new()
	var sm := BoxMesh.new()
	sm.size = Vector3(2.55, 0.05, 0.32)
	var smat := StandardMaterial3D.new()
	smat.albedo_color = Color(0.95, 0.80, 0.14, 1)
	smat.roughness = 0.5
	smat.emission_enabled = true
	smat.emission = Color(0.85, 0.68, 0.10, 1)
	smat.emission_energy_multiplier = 1.5
	sm.material = smat
	stripe.mesh = sm
	stripe.position = Vector3(0.0, plank_c + 0.10, cos(theta) * 1.28)
	stripe.rotation_degrees = Vector3(rot_x, 0.0, 0.0)
	ramp.add_child(stripe)

	ramp.position = Vector3(pos.x, 0.0, pos.z)
	ramp.rotation_degrees.y = rot_deg.y
	root.add_child(ramp)


# --------------------------------------------------------------- buildings ---

func _facade_texture_for(node_name: String) -> Texture2D:
	match node_name:
		"Workshop":
			return load("res://assets/tex_facade_workshop.png") as Texture2D
		"Shed":
			return load("res://assets/tex_facade_shed.png") as Texture2D
		"Store":
			return load("res://assets/tex_facade_store.png") as Texture2D
		"Depot", "Freight":
			return load("res://assets/tex_facade_depot.jpg") as Texture2D
		"Garage":
			return load("res://assets/tex_facade_garage.jpg") as Texture2D
		"Warehouse":
			return load("res://assets/tex_facade_warehouse.jpg") as Texture2D
		_:
			return null


func _add_building(root: Node, node_name: String, display_name: String,
		origin: Vector3, size: Vector3, wall_color: Color) -> StaticBody3D:
	var building := StaticBody3D.new()
	building.name = node_name
	building.set_script(load(BUILDING))
	building.set("building_name", display_name)

	var col := CollisionShape3D.new()
	var box_shape := BoxShape3D.new()
	box_shape.size = size
	col.shape = box_shape
	col.position = Vector3(0.0, size.y * 0.5, 0.0)
	building.add_child(col)

	var facade := _facade_texture_for(node_name)
	var body_mesh := BoxMesh.new()
	body_mesh.size = size
	var wall_mat := StandardMaterial3D.new()
	if facade != null:
		wall_mat.albedo_texture = facade
		wall_mat.albedo_color = Color(1.0, 1.0, 1.0, 1.0)
		wall_mat.uv1_scale = Vector3(1.0, 1.0, 1.0)
	else:
		wall_mat.albedo_color = wall_color
	wall_mat.roughness = 0.85
	body_mesh.material = wall_mat
	var body_inst := MeshInstance3D.new()
	body_inst.name = "MainBlock"
	body_inst.mesh = body_mesh
	body_inst.position = Vector3(0.0, size.y * 0.5, 0.0)
	building.add_child(body_inst)

	var roof_mesh := BoxMesh.new()
	roof_mesh.size = Vector3(size.x + 0.5, 0.28, size.z + 0.5)
	var roof_mat := StandardMaterial3D.new()
	roof_mat.albedo_color = Color(0.22, 0.23, 0.24, 1)
	roof_mat.roughness = 0.8
	roof_mesh.material = roof_mat
	var roof_inst := MeshInstance3D.new()
	roof_inst.name = "Roof"
	roof_inst.mesh = roof_mesh
	roof_inst.position = Vector3(0.0, size.y + 0.14, 0.0)
	building.add_child(roof_inst)

	var door_mesh := BoxMesh.new()
	door_mesh.size = Vector3(size.x * 0.38, size.y * 0.62, 0.08)
	var door_mat := StandardMaterial3D.new()
	door_mat.albedo_color = Color(0.13, 0.12, 0.11, 1)
	door_mat.roughness = 0.7
	door_mesh.material = door_mat
	var door := MeshInstance3D.new()
	door.name = "Door"
	door.mesh = door_mesh
	door.position = Vector3(0.0, size.y * 0.31, size.z * 0.5 + 0.045)
	building.add_child(door)
	var awning_mesh := BoxMesh.new()
	awning_mesh.size = Vector3(size.x * 0.46, 0.10, 0.34)
	var awning_mat := StandardMaterial3D.new()
	awning_mat.albedo_color = Color(0.85, 0.42, 0.08, 1)
	awning_mat.roughness = 0.55
	awning_mesh.material = awning_mat
	var awning := MeshInstance3D.new()
	awning.name = "Awning"
	awning.mesh = awning_mesh
	awning.position = Vector3(0.0, size.y * 0.62 + 0.28, size.z * 0.5 + 0.16)
	building.add_child(awning)

	DECOR.dress(building, size, display_name)

	building.position = origin
	building.rotation.y = atan2(origin.x, origin.z) + PI
	root.add_child(building)
	return building
